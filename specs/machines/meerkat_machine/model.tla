    /\ (((IF (arg_session_id \in DOMAIN live_active_channel_by_session) THEN Some((IF arg_session_id \in DOMAIN live_active_channel_by_session THEN live_active_channel_by_session[arg_session_id] ELSE "None")) ELSE None) = Some(replacement_channel_id)) /\ ((IF (replacement_channel_id \in DOMAIN live_channel_session_by_channel) THEN Some((IF replacement_channel_id \in DOMAIN live_channel_session_by_channel THEN live_channel_session_by_channel[replacement_channel_id] ELSE "None")) ELSE None) = Some(arg_session_id)) /\ ((IF (replacement_channel_id \in DOMAIN live_channel_identity_by_channel) THEN Some((IF replacement_channel_id \in DOMAIN live_channel_identity_by_channel THEN live_channel_identity_by_channel[replacement_channel_id] ELSE "None")) ELSE None) = (IF (closing_channel_id \in DOMAIN live_context_recovery_identity_by_channel) THEN Some((IF closing_channel_id \in DOMAIN live_context_recovery_identity_by_channel THEN live_context_recovery_identity_by_channel[closing_channel_id] ELSE "None")) ELSE None)))
