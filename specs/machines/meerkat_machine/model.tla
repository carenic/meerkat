    /\ ((IF ((IF (arg_phase = "Consumed") THEN TRUE ELSE (IF (arg_phase = "Superseded") THEN TRUE ELSE (IF (arg_phase = "Coalesced") THEN TRUE ELSE (arg_phase = "Abandoned")))) /\ (recovery_lane = None)) THEN TRUE ELSE (IF ~((arg_phase # "Consumed")) THEN TRUE ELSE (IF ~((arg_phase # "Superseded")) THEN TRUE ELSE (IF ~((arg_phase # "Coalesced")) THEN TRUE ELSE (IF ~((arg_phase # "Abandoned")) THEN TRUE ELSE (IF ~((input_id \in DOMAIN recovered_admitted_lanes)) THEN TRUE ELSE (input_id \in DOMAIN recovered_admitted_lanes))))))) /\ (IF ((IF (arg_phase = "Consumed") THEN TRUE ELSE (IF (arg_phase = "Superseded") THEN TRUE ELSE (IF (arg_phase = "Coalesced") THEN TRUE ELSE (arg_phase = "Abandoned")))) /\ (recovery_lane = None)) THEN TRUE ELSE ((arg_phase # "Consumed") /\ (arg_phase # "Superseded") /\ (arg_phase # "Coalesced") /\ (arg_phase # "Abandoned") /\ (input_id \in DOMAIN recovered_admitted_lanes) /\ (recovery_lane = Some((recovered_admitted_lanes)[input_id])))))
    /\ ((IF ((arg_phase # "Queued") /\ (lane = None)) THEN TRUE ELSE (IF ~((arg_phase = "Queued")) THEN TRUE ELSE (IF ~((input_id \in DOMAIN recovered_admitted_lanes)) THEN TRUE ELSE (input_id \in DOMAIN recovered_admitted_lanes)))) /\ (IF ((arg_phase # "Queued") /\ (lane = None)) THEN TRUE ELSE ((arg_phase = "Queued") /\ (input_id \in DOMAIN recovered_admitted_lanes) /\ (lane = Some((recovered_admitted_lanes)[input_id])) /\ (lane = recovery_lane))))
