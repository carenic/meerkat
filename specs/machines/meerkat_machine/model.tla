operation_source_valid(source) == (IF (source = None) THEN TRUE ELSE (IF (((IF "value" \in DOMAIN source THEN source["value"] ELSE None).kind = "SessionChild") /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).session_id # None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).peer_id = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).address = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).realm_id = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).job_id = None)) THEN TRUE ELSE (IF (((IF "value" \in DOMAIN source THEN source["value"] ELSE None).kind = "BackendPeer") /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).session_id = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).peer_id # None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).address # None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).realm_id = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).job_id = None)) THEN TRUE ELSE (((IF "value" \in DOMAIN source THEN source["value"] ELSE None).kind = "DetachedJob") /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).session_id = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).peer_id = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).address = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).realm_id # None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).job_id # None)))))
handoff_record_outcome_free(record) == ((record.applied_model = None) /\ (record.denial_reason = None))
handoff_record_binds_same_request(existing, proposed) == ((existing.originating_run = proposed.originating_run) /\ (existing.target_model = proposed.target_model))
llm_failure_kind_recoverable(kind) == (IF (kind = "RateLimited") THEN TRUE ELSE (IF (kind = "NetworkTimeout") THEN TRUE ELSE (IF (kind = "CallTimeout") THEN TRUE ELSE (kind = "RetryableProviderError"))))
operation_status_terminal(status) == (IF (status = "Completed") THEN TRUE ELSE (IF (status = "Failed") THEN TRUE ELSE (IF (status = "Aborted") THEN TRUE ELSE (IF (status = "Cancelled") THEN TRUE ELSE (IF (status = "Retired") THEN TRUE ELSE (status = "Terminated"))))))
op_lifecycle_action_status_valid(action, status) == (IF ((action = "Start") /\ (status = "Provisioning")) THEN TRUE ELSE (IF ((action = "Fail") /\ (IF (status = "Provisioning") THEN TRUE ELSE (IF (status = "Running") THEN TRUE ELSE (status = "Retiring")))) THEN TRUE ELSE (IF ((action = "PeerReady") /\ (IF (status = "Running") THEN TRUE ELSE (status = "Retiring"))) THEN TRUE ELSE (IF ((action = "ProgressReported") /\ (IF (status = "Running") THEN TRUE ELSE (status = "Retiring"))) THEN TRUE ELSE (IF ((action = "Complete") /\ (IF (status = "Running") THEN TRUE ELSE (status = "Retiring"))) THEN TRUE ELSE (IF ((action = "Abort") /\ (status = "Provisioning")) THEN TRUE ELSE (IF ((action = "Cancel") /\ (IF (status = "Provisioning") THEN TRUE ELSE (IF (status = "Running") THEN TRUE ELSE (status = "Retiring")))) THEN TRUE ELSE (IF ((action = "RetireRequested") /\ (status = "Running")) THEN TRUE ELSE (IF ((action = "RetireCompleted") /\ (IF (status = "Running") THEN TRUE ELSE (status = "Retiring"))) THEN TRUE ELSE ((action = "Terminate") /\ (IF (status = "Provisioning") THEN TRUE ELSE (IF (status = "Running") THEN TRUE ELSE (status = "Retiring")))))))))))))
deferred_authority_has_identity(witness) == (Cardinality(witness) > 0)
runtime_authority_reconcile_decision(observation_kind, state, agent_runtime_id, fence_token, runtime_generation, runtime_epoch_id, arg_current_run_id, arg_pre_run_phase, malformed_reclaim_safe) == (IF (observation_kind = "Unavailable") THEN "Backoff" ELSE (IF (observation_kind = "Unsupported") THEN "RepairBlocked" ELSE (IF (observation_kind = "Malformed") THEN (IF malformed_reclaim_safe THEN "Quarantine" ELSE "RepairBlocked") ELSE (IF (observation_kind = "Missing") THEN "NormalizeOrReplace" ELSE (IF ((state = Some("Idle")) /\ (agent_runtime_id = None) /\ (fence_token = None) /\ (runtime_generation = None) /\ (arg_current_run_id = None) /\ (arg_pre_run_phase = None)) THEN "Converged" ELSE "NormalizeOrReplace")))))
meerkat_session_llm_filter_allows_view_image(filter) == (IF (filter.tag = "All") THEN TRUE ELSE (IF ((filter.tag = "Allow") /\ (\E name \in meerkat_tool_visibility_filter_names(filter) : (name = "view_image"))) THEN TRUE ELSE ((filter.tag = "Deny") /\ ~((\E name \in meerkat_tool_visibility_filter_names(filter) : (name = "view_image"))))))
meerkat_session_llm_filter_has_view_image_only(filter) == ((filter.tag = "Deny") /\ (Cardinality(meerkat_tool_visibility_filter_names(filter)) = 1) /\ (\E name \in meerkat_tool_visibility_filter_names(filter) : (name = "view_image")))
meerkat_tool_visibility_names_are_catalog_backed(names, authority_catalog) == (\A name \in names : ((name \in DOMAIN authority_catalog) /\ deferred_authority_has_identity((IF "value" \in DOMAIN (IF (name \in DOMAIN authority_catalog) THEN Some((IF name \in DOMAIN authority_catalog THEN authority_catalog[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN authority_catalog) THEN Some((IF name \in DOMAIN authority_catalog THEN authority_catalog[name] ELSE "None")) ELSE None)["value"] ELSE None))))
meerkat_tool_visibility_filter_witnesses_are_catalog_backed(witnesses, authority_catalog) == (\A name \in DOMAIN witnesses : ((name \in DOMAIN authority_catalog) /\ ((IF "value" \in DOMAIN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None)["value"] ELSE None) = (IF "value" \in DOMAIN (IF (name \in DOMAIN authority_catalog) THEN Some((IF name \in DOMAIN authority_catalog THEN authority_catalog[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN authority_catalog) THEN Some((IF name \in DOMAIN authority_catalog THEN authority_catalog[name] ELSE "None")) ELSE None)["value"] ELSE None)) /\ deferred_authority_has_identity((IF "value" \in DOMAIN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None)["value"] ELSE None))))
meerkat_tool_visibility_filter_has_catalog_witnesses(filter, witnesses, authority_catalog) == (\A name \in meerkat_tool_visibility_filter_names(filter) : ((name \in DOMAIN witnesses) /\ (name \in DOMAIN authority_catalog) /\ ((IF "value" \in DOMAIN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None)["value"] ELSE None) = (IF "value" \in DOMAIN (IF (name \in DOMAIN authority_catalog) THEN Some((IF name \in DOMAIN authority_catalog THEN authority_catalog[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN authority_catalog) THEN Some((IF name \in DOMAIN authority_catalog THEN authority_catalog[name] ELSE "None")) ELSE None)["value"] ELSE None)) /\ deferred_authority_has_identity((IF "value" \in DOMAIN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None)["value"] ELSE None))))
meerkat_tool_visibility_authorities_are_catalog_backed(authorities, authority_catalog) == (\A name \in DOMAIN authorities : ((name \in DOMAIN authority_catalog) /\ ((IF "value" \in DOMAIN (IF (name \in DOMAIN authorities) THEN Some((IF name \in DOMAIN authorities THEN authorities[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN authorities) THEN Some((IF name \in DOMAIN authorities THEN authorities[name] ELSE "None")) ELSE None)["value"] ELSE None) = (IF "value" \in DOMAIN (IF (name \in DOMAIN authority_catalog) THEN Some((IF name \in DOMAIN authority_catalog THEN authority_catalog[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN authority_catalog) THEN Some((IF name \in DOMAIN authority_catalog THEN authority_catalog[name] ELSE "None")) ELSE None)["value"] ELSE None)) /\ deferred_authority_has_identity((IF "value" \in DOMAIN (IF (name \in DOMAIN authorities) THEN Some((IF name \in DOMAIN authorities THEN authorities[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN authorities) THEN Some((IF name \in DOMAIN authorities THEN authorities[name] ELSE "None")) ELSE None)["value"] ELSE None))))
