    /\ live_member_turn_reasoning_by_channel' = MapRemove(live_member_turn_reasoning_by_channel, channel_id)
    /\ live_execution_runtime_id_by_channel' = MapRemove(live_execution_runtime_id_by_channel, channel_id)
