    /\ live_result_delivery_operation_by_channel' = IF (channel_id \in DOMAIN live_result_delivery_operation_by_channel) THEN MapRemove(live_result_delivery_operation_by_channel, channel_id) ELSE live_result_delivery_operation_by_channel
