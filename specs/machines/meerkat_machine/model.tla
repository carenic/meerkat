meerkat_session_llm_visibility_delta_matches(tool_visibility_delta, previous_capability_base_filter, next_capability_base_filter, committed_visible_set_changed) == ((tool_visibility_delta.previous_capability_base_filter = previous_capability_base_filter) /\ (tool_visibility_delta.current_capability_base_filter = next_capability_base_filter) /\ (tool_visibility_delta.committed_visible_set_changed = committed_visible_set_changed) /\ (tool_visibility_delta.revision_bumped = committed_visible_set_changed))
meerkat_session_llm_visibility_shape_matches(previous_visibility_state, next_visibility_state, previous_capability_base_filter, next_capability_base_filter, previous_active_visibility_revision, previous_staged_visibility_revision, next_active_visibility_revision) == ((previous_visibility_state.capability_base_filter = previous_capability_base_filter) /\ (next_visibility_state.capability_base_filter = next_capability_base_filter) /\ (previous_visibility_state.inherited_base_filter = next_visibility_state.inherited_base_filter) /\ (previous_visibility_state.active_filter = next_visibility_state.active_filter) /\ (previous_visibility_state.staged_filter = next_visibility_state.staged_filter) /\ (previous_visibility_state.active_requested_deferred_names = next_visibility_state.active_requested_deferred_names) /\ (previous_visibility_state.staged_requested_deferred_names = next_visibility_state.staged_requested_deferred_names) /\ (previous_visibility_state.requested_witnesses = next_visibility_state.requested_witnesses) /\ (previous_visibility_state.filter_witnesses = next_visibility_state.filter_witnesses) /\ (previous_visibility_state.active_revision = previous_active_visibility_revision) /\ (previous_visibility_state.staged_revision = previous_staged_visibility_revision) /\ (next_visibility_state.active_revision = next_active_visibility_revision))
meerkat_session_llm_expected_next_staged_visibility_revision(committed_visible_set_changed, previous_active_visibility_revision, previous_staged_visibility_revision, next_active_visibility_revision) == (IF committed_visible_set_changed THEN (IF (previous_staged_visibility_revision > previous_active_visibility_revision) THEN (next_active_visibility_revision + 1) ELSE next_active_visibility_revision) ELSE previous_staged_visibility_revision)
meerkat_session_llm_expected_next_visibility_revision(committed_visible_set_changed, previous_active_visibility_revision, previous_staged_visibility_revision) == (IF committed_visible_set_changed THEN (IF (previous_active_visibility_revision >= previous_staged_visibility_revision) THEN (previous_active_visibility_revision + 1) ELSE (previous_staged_visibility_revision + 1)) ELSE previous_active_visibility_revision)
meerkat_session_llm_profile_provenance_matches(target_identity, target_profile_provider, target_profile_model, target_capability_surface_status) == (IF (target_capability_surface_status = "Resolved") THEN ((target_profile_provider # None) /\ (target_profile_model # None) /\ ((IF "value" \in DOMAIN target_profile_provider THEN target_profile_provider["value"] ELSE None) = target_identity.provider) /\ ((IF "value" \in DOMAIN target_profile_model THEN target_profile_model["value"] ELSE None) = target_identity.model)) ELSE ((target_profile_provider = None) /\ (target_profile_model = None)))
meerkat_tool_visibility_authorities_match_names(names, witnesses, authorities) == ((DOMAIN authorities = names) /\ (\A name \in names : ((name \in DOMAIN witnesses) /\ ((IF "value" \in DOMAIN (IF (name \in DOMAIN authorities) THEN Some((IF name \in DOMAIN authorities THEN authorities[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN authorities) THEN Some((IF name \in DOMAIN authorities THEN authorities[name] ELSE "None")) ELSE None)["value"] ELSE None) = (IF "value" \in DOMAIN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None)["value"] ELSE None)))))
meerkat_tool_visibility_filter_names(filter) == (IF (filter.tag = "All") THEN {} ELSE (IF (filter.tag = "Allow") THEN (IF filter.tag = "Allow" THEN filter.names ELSE {}) ELSE (IF filter.tag = "Deny" THEN filter.names ELSE {})))
wait_operation_token_witness_valid(operation_ids, operation_id_tokens, operation_token_by_id, operation_id_by_token) == ((Cardinality(operation_ids) = Cardinality(operation_id_tokens)) /\ (DOMAIN operation_token_by_id = operation_ids) /\ (DOMAIN operation_id_by_token = operation_id_tokens) /\ (\A operation_id \in operation_ids : ((IF "value" \in DOMAIN (IF ((IF "value" \in DOMAIN (IF (operation_id \in DOMAIN operation_token_by_id) THEN Some((IF operation_id \in DOMAIN operation_token_by_id THEN operation_token_by_id[operation_id] ELSE "None")) ELSE None) THEN (IF (operation_id \in DOMAIN operation_token_by_id) THEN Some((IF operation_id \in DOMAIN operation_token_by_id THEN operation_token_by_id[operation_id] ELSE "None")) ELSE None)["value"] ELSE None) \in DOMAIN operation_id_by_token) THEN Some((IF (IF "value" \in DOMAIN (IF (operation_id \in DOMAIN operation_token_by_id) THEN Some((IF operation_id \in DOMAIN operation_token_by_id THEN operation_token_by_id[operation_id] ELSE "None")) ELSE None) THEN (IF (operation_id \in DOMAIN operation_token_by_id) THEN Some((IF operation_id \in DOMAIN operation_token_by_id THEN operation_token_by_id[operation_id] ELSE "None")) ELSE None)["value"] ELSE None) \in DOMAIN operation_id_by_token THEN operation_id_by_token[(IF "value" \in DOMAIN (IF (operation_id \in DOMAIN operation_token_by_id) THEN Some((IF operation_id \in DOMAIN operation_token_by_id THEN operation_token_by_id[operation_id] ELSE "None")) ELSE None) THEN (IF (operation_id \in DOMAIN operation_token_by_id) THEN Some((IF operation_id \in DOMAIN operation_token_by_id THEN operation_token_by_id[operation_id] ELSE "None")) ELSE None)["value"] ELSE None)] ELSE "None")) ELSE None) THEN (IF ((IF "value" \in DOMAIN (IF (operation_id \in DOMAIN operation_token_by_id) THEN Some((IF operation_id \in DOMAIN operation_token_by_id THEN operation_token_by_id[operation_id] ELSE "None")) ELSE None) THEN (IF (operation_id \in DOMAIN operation_token_by_id) THEN Some((IF operation_id \in DOMAIN operation_token_by_id THEN operation_token_by_id[operation_id] ELSE "None")) ELSE None)["value"] ELSE None) \in DOMAIN operation_id_by_token) THEN Some((IF (IF "value" \in DOMAIN (IF (operation_id \in DOMAIN operation_token_by_id) THEN Some((IF operation_id \in DOMAIN operation_token_by_id THEN operation_token_by_id[operation_id] ELSE "None")) ELSE None) THEN (IF (operation_id \in DOMAIN operation_token_by_id) THEN Some((IF operation_id \in DOMAIN operation_token_by_id THEN operation_token_by_id[operation_id] ELSE "None")) ELSE None)["value"] ELSE None) \in DOMAIN operation_id_by_token THEN operation_id_by_token[(IF "value" \in DOMAIN (IF (operation_id \in DOMAIN operation_token_by_id) THEN Some((IF operation_id \in DOMAIN operation_token_by_id THEN operation_token_by_id[operation_id] ELSE "None")) ELSE None) THEN (IF (operation_id \in DOMAIN operation_token_by_id) THEN Some((IF operation_id \in DOMAIN operation_token_by_id THEN operation_token_by_id[operation_id] ELSE "None")) ELSE None)["value"] ELSE None)] ELSE "None")) ELSE None)["value"] ELSE None) = operation_id)) /\ (\A operation_id_token \in operation_id_tokens : ((IF "value" \in DOMAIN (IF ((IF "value" \in DOMAIN (IF (operation_id_token \in DOMAIN operation_id_by_token) THEN Some((IF operation_id_token \in DOMAIN operation_id_by_token THEN operation_id_by_token[operation_id_token] ELSE "None")) ELSE None) THEN (IF (operation_id_token \in DOMAIN operation_id_by_token) THEN Some((IF operation_id_token \in DOMAIN operation_id_by_token THEN operation_id_by_token[operation_id_token] ELSE "None")) ELSE None)["value"] ELSE None) \in DOMAIN operation_token_by_id) THEN Some((IF (IF "value" \in DOMAIN (IF (operation_id_token \in DOMAIN operation_id_by_token) THEN Some((IF operation_id_token \in DOMAIN operation_id_by_token THEN operation_id_by_token[operation_id_token] ELSE "None")) ELSE None) THEN (IF (operation_id_token \in DOMAIN operation_id_by_token) THEN Some((IF operation_id_token \in DOMAIN operation_id_by_token THEN operation_id_by_token[operation_id_token] ELSE "None")) ELSE None)["value"] ELSE None) \in DOMAIN operation_token_by_id THEN operation_token_by_id[(IF "value" \in DOMAIN (IF (operation_id_token \in DOMAIN operation_id_by_token) THEN Some((IF operation_id_token \in DOMAIN operation_id_by_token THEN operation_id_by_token[operation_id_token] ELSE "None")) ELSE None) THEN (IF (operation_id_token \in DOMAIN operation_id_by_token) THEN Some((IF operation_id_token \in DOMAIN operation_id_by_token THEN operation_id_by_token[operation_id_token] ELSE "None")) ELSE None)["value"] ELSE None)] ELSE "None")) ELSE None) THEN (IF ((IF "value" \in DOMAIN (IF (operation_id_token \in DOMAIN operation_id_by_token) THEN Some((IF operation_id_token \in DOMAIN operation_id_by_token THEN operation_id_by_token[operation_id_token] ELSE "None")) ELSE None) THEN (IF (operation_id_token \in DOMAIN operation_id_by_token) THEN Some((IF operation_id_token \in DOMAIN operation_id_by_token THEN operation_id_by_token[operation_id_token] ELSE "None")) ELSE None)["value"] ELSE None) \in DOMAIN operation_token_by_id) THEN Some((IF (IF "value" \in DOMAIN (IF (operation_id_token \in DOMAIN operation_id_by_token) THEN Some((IF operation_id_token \in DOMAIN operation_id_by_token THEN operation_id_by_token[operation_id_token] ELSE "None")) ELSE None) THEN (IF (operation_id_token \in DOMAIN operation_id_by_token) THEN Some((IF operation_id_token \in DOMAIN operation_id_by_token THEN operation_id_by_token[operation_id_token] ELSE "None")) ELSE None)["value"] ELSE None) \in DOMAIN operation_token_by_id THEN operation_token_by_id[(IF "value" \in DOMAIN (IF (operation_id_token \in DOMAIN operation_id_by_token) THEN Some((IF operation_id_token \in DOMAIN operation_id_by_token THEN operation_id_by_token[operation_id_token] ELSE "None")) ELSE None) THEN (IF (operation_id_token \in DOMAIN operation_id_by_token) THEN Some((IF operation_id_token \in DOMAIN operation_id_by_token THEN operation_id_by_token[operation_id_token] ELSE "None")) ELSE None)["value"] ELSE None)] ELSE "None")) ELSE None)["value"] ELSE None) = operation_id_token)))
operation_source_valid(source) == (IF (source = None) THEN TRUE ELSE (IF (((IF "value" \in DOMAIN source THEN source["value"] ELSE None).kind = "SessionChild") /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).session_id # None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).peer_id = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).address = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).realm_id = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).job_id = None)) THEN TRUE ELSE (IF (((IF "value" \in DOMAIN source THEN source["value"] ELSE None).kind = "BackendPeer") /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).session_id = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).peer_id # None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).address # None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).realm_id = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).job_id = None)) THEN TRUE ELSE (((IF "value" \in DOMAIN source THEN source["value"] ELSE None).kind = "DetachedJob") /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).session_id = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).peer_id = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).address = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).realm_id # None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).job_id # None)))))
llm_failure_kind_recoverable(kind) == (IF (kind = "RateLimited") THEN TRUE ELSE (IF (kind = "NetworkTimeout") THEN TRUE ELSE (IF (kind = "CallTimeout") THEN TRUE ELSE (kind = "RetryableProviderError"))))
operation_status_terminal(status) == (IF (status = "Completed") THEN TRUE ELSE (IF (status = "Failed") THEN TRUE ELSE (IF (status = "Aborted") THEN TRUE ELSE (IF (status = "Cancelled") THEN TRUE ELSE (IF (status = "Retired") THEN TRUE ELSE (status = "Terminated"))))))
op_lifecycle_action_status_valid(action, status) == (IF ((action = "Start") /\ (status = "Provisioning")) THEN TRUE ELSE (IF ((action = "Fail") /\ (IF (status = "Provisioning") THEN TRUE ELSE (IF (status = "Running") THEN TRUE ELSE (status = "Retiring")))) THEN TRUE ELSE (IF ((action = "PeerReady") /\ (IF (status = "Running") THEN TRUE ELSE (status = "Retiring"))) THEN TRUE ELSE (IF ((action = "ProgressReported") /\ (IF (status = "Running") THEN TRUE ELSE (status = "Retiring"))) THEN TRUE ELSE (IF ((action = "Complete") /\ (IF (status = "Running") THEN TRUE ELSE (status = "Retiring"))) THEN TRUE ELSE (IF ((action = "Abort") /\ (status = "Provisioning")) THEN TRUE ELSE (IF ((action = "Cancel") /\ (IF (status = "Provisioning") THEN TRUE ELSE (IF (status = "Running") THEN TRUE ELSE (status = "Retiring")))) THEN TRUE ELSE (IF ((action = "RetireRequested") /\ (status = "Running")) THEN TRUE ELSE (IF ((action = "RetireCompleted") /\ (IF (status = "Running") THEN TRUE ELSE (status = "Retiring"))) THEN TRUE ELSE ((action = "Terminate") /\ (IF (status = "Provisioning") THEN TRUE ELSE (IF (status = "Running") THEN TRUE ELSE (status = "Retiring")))))))))))))
deferred_authority_has_identity(witness) == (Cardinality(witness) > 0)
runtime_authority_reconcile_decision(observation_kind, state, agent_runtime_id, fence_token, runtime_generation, runtime_epoch_id, arg_current_run_id, arg_pre_run_phase, malformed_reclaim_safe) == (IF (observation_kind = "Unavailable") THEN "Backoff" ELSE (IF (observation_kind = "Unsupported") THEN "RepairBlocked" ELSE (IF (observation_kind = "Malformed") THEN (IF malformed_reclaim_safe THEN "Quarantine" ELSE "RepairBlocked") ELSE (IF (observation_kind = "Missing") THEN "NormalizeOrReplace" ELSE (IF ((state = Some("Idle")) /\ (agent_runtime_id = None) /\ (fence_token = None) /\ (runtime_generation = None) /\ (arg_current_run_id = None) /\ (arg_pre_run_phase = None)) THEN "Converged" ELSE "NormalizeOrReplace")))))
meerkat_session_llm_filter_allows_view_image(filter) == (IF (filter.tag = "All") THEN TRUE ELSE (IF ((filter.tag = "Allow") /\ (\E name \in meerkat_tool_visibility_filter_names(filter) : (name = "view_image"))) THEN TRUE ELSE ((filter.tag = "Deny") /\ ~((\E name \in meerkat_tool_visibility_filter_names(filter) : (name = "view_image"))))))
meerkat_session_llm_filter_has_view_image_only(filter) == ((filter.tag = "Deny") /\ (Cardinality(meerkat_tool_visibility_filter_names(filter)) = 1) /\ (\E name \in meerkat_tool_visibility_filter_names(filter) : (name = "view_image")))
meerkat_tool_visibility_names_are_catalog_backed(names, authority_catalog) == (\A name \in names : ((name \in DOMAIN authority_catalog) /\ deferred_authority_has_identity((IF "value" \in DOMAIN (IF (name \in DOMAIN authority_catalog) THEN Some((IF name \in DOMAIN authority_catalog THEN authority_catalog[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN authority_catalog) THEN Some((IF name \in DOMAIN authority_catalog THEN authority_catalog[name] ELSE "None")) ELSE None)["value"] ELSE None))))
meerkat_tool_visibility_filter_witnesses_are_catalog_backed(witnesses, authority_catalog) == (\A name \in DOMAIN witnesses : ((name \in DOMAIN authority_catalog) /\ ((IF "value" \in DOMAIN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None)["value"] ELSE None) = (IF "value" \in DOMAIN (IF (name \in DOMAIN authority_catalog) THEN Some((IF name \in DOMAIN authority_catalog THEN authority_catalog[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN authority_catalog) THEN Some((IF name \in DOMAIN authority_catalog THEN authority_catalog[name] ELSE "None")) ELSE None)["value"] ELSE None)) /\ deferred_authority_has_identity((IF "value" \in DOMAIN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None)["value"] ELSE None))))
meerkat_tool_visibility_filter_has_catalog_witnesses(filter, witnesses, authority_catalog) == (\A name \in meerkat_tool_visibility_filter_names(filter) : ((name \in DOMAIN witnesses) /\ (name \in DOMAIN authority_catalog) /\ ((IF "value" \in DOMAIN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None)["value"] ELSE None) = (IF "value" \in DOMAIN (IF (name \in DOMAIN authority_catalog) THEN Some((IF name \in DOMAIN authority_catalog THEN authority_catalog[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN authority_catalog) THEN Some((IF name \in DOMAIN authority_catalog THEN authority_catalog[name] ELSE "None")) ELSE None)["value"] ELSE None)) /\ deferred_authority_has_identity((IF "value" \in DOMAIN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None)["value"] ELSE None))))
meerkat_tool_visibility_authorities_are_catalog_backed(authorities, authority_catalog) == (\A name \in DOMAIN authorities : ((name \in DOMAIN authority_catalog) /\ ((IF "value" \in DOMAIN (IF (name \in DOMAIN authorities) THEN Some((IF name \in DOMAIN authorities THEN authorities[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN authorities) THEN Some((IF name \in DOMAIN authorities THEN authorities[name] ELSE "None")) ELSE None)["value"] ELSE None) = (IF "value" \in DOMAIN (IF (name \in DOMAIN authority_catalog) THEN Some((IF name \in DOMAIN authority_catalog THEN authority_catalog[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN authority_catalog) THEN Some((IF name \in DOMAIN authority_catalog THEN authority_catalog[name] ELSE "None")) ELSE None)["value"] ELSE None)) /\ deferred_authority_has_identity((IF "value" \in DOMAIN (IF (name \in DOMAIN authorities) THEN Some((IF name \in DOMAIN authorities THEN authorities[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN authorities) THEN Some((IF name \in DOMAIN authorities THEN authorities[name] ELSE "None")) ELSE None)["value"] ELSE None))))
meerkat_tool_visibility_filter_has_identity_witnesses(filter, witnesses) == (\A name \in meerkat_tool_visibility_filter_names(filter) : ((name \in DOMAIN witnesses) /\ deferred_authority_has_identity((IF "value" \in DOMAIN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None)["value"] ELSE None))))
deferred_authorities_have_identity(names, witnesses) == (\A requested_name \in names : deferred_authority_has_identity((IF "value" \in DOMAIN (IF (requested_name \in DOMAIN witnesses) THEN Some((IF requested_name \in DOMAIN witnesses THEN witnesses[requested_name] ELSE "None")) ELSE None) THEN (IF (requested_name \in DOMAIN witnesses) THEN Some((IF requested_name \in DOMAIN witnesses THEN witnesses[requested_name] ELSE "None")) ELSE None)["value"] ELSE None)))
op_lifecycle_transition_rejection_idempotent(action, status) == (IF ((action = "Start") /\ (status = "Running")) THEN TRUE ELSE (IF ((action = "RetireRequested") /\ (status = "Retiring")) THEN TRUE ELSE ((IF (action = "PeerReady") THEN TRUE ELSE (IF (action = "ProgressReported") THEN TRUE ELSE (IF (action = "RetireRequested") THEN TRUE ELSE (IF (action = "RetireCompleted") THEN TRUE ELSE (action = "Abort"))))) /\ operation_status_terminal(status))))
meerkat_session_llm_visibility_state_allows_view_image(view_image_tool_available, visibility_state) == (view_image_tool_available /\ meerkat_session_llm_filter_allows_view_image(visibility_state.capability_base_filter) /\ meerkat_session_llm_filter_allows_view_image(visibility_state.inherited_base_filter) /\ meerkat_session_llm_filter_allows_view_image(visibility_state.active_filter))
meerkat_session_llm_capability_base_filter_matches(target_capability_surface, next_capability_base_filter) == (IF target_capability_surface.image_tool_results THEN (next_capability_base_filter.tag = "All") ELSE ((next_capability_base_filter.tag = "Deny") /\ meerkat_session_llm_filter_has_view_image_only(next_capability_base_filter)))
meerkat_tool_visibility_state_replacement_matches(arg_inherited_base_filter, arg_active_filter, arg_staged_filter, active_requested_deferred_names, staged_requested_deferred_names, requested_witnesses, filter_witnesses, arg_active_deferred_authorities, arg_staged_deferred_authorities, deferred_authority_catalog, filter_authority_catalog, arg_active_visibility_revision, arg_staged_visibility_revision) == ((IF (arg_active_visibility_revision # arg_staged_visibility_revision) THEN TRUE ELSE ((arg_active_filter = arg_staged_filter) /\ (active_requested_deferred_names = staged_requested_deferred_names) /\ (arg_active_deferred_authorities = arg_staged_deferred_authorities))) /\ (\A name \in DOMAIN requested_witnesses : (IF (name \in active_requested_deferred_names) THEN TRUE ELSE (name \in staged_requested_deferred_names))) /\ meerkat_tool_visibility_filter_witnesses_are_catalog_backed(filter_witnesses, filter_authority_catalog) /\ meerkat_tool_visibility_filter_has_catalog_witnesses(arg_inherited_base_filter, filter_witnesses, filter_authority_catalog) /\ meerkat_tool_visibility_filter_has_catalog_witnesses(arg_active_filter, filter_witnesses, filter_authority_catalog) /\ meerkat_tool_visibility_filter_has_catalog_witnesses(arg_staged_filter, filter_witnesses, filter_authority_catalog) /\ meerkat_tool_visibility_authorities_are_catalog_backed(requested_witnesses, deferred_authority_catalog) /\ meerkat_tool_visibility_authorities_are_catalog_backed(arg_active_deferred_authorities, deferred_authority_catalog) /\ meerkat_tool_visibility_authorities_are_catalog_backed(arg_staged_deferred_authorities, deferred_authority_catalog) /\ meerkat_tool_visibility_authorities_match_names(active_requested_deferred_names, requested_witnesses, arg_active_deferred_authorities) /\ meerkat_tool_visibility_authorities_match_names(staged_requested_deferred_names, requested_witnesses, arg_staged_deferred_authorities))
meerkat_tool_visibility_publish_matches_catalog(arg_active_filter, arg_staged_filter, arg_active_deferred_authorities, arg_staged_deferred_authorities, filter_witnesses, deferred_authority_catalog, filter_authority_catalog) == (meerkat_tool_visibility_filter_has_catalog_witnesses(arg_active_filter, filter_witnesses, filter_authority_catalog) /\ meerkat_tool_visibility_filter_has_catalog_witnesses(arg_staged_filter, filter_witnesses, filter_authority_catalog) /\ meerkat_tool_visibility_authorities_are_catalog_backed(arg_active_deferred_authorities, deferred_authority_catalog) /\ meerkat_tool_visibility_authorities_are_catalog_backed(arg_staged_deferred_authorities, deferred_authority_catalog))
meerkat_session_llm_visibility_reconfigure_plan_matches(previous_visibility_state, next_visibility_state, previous_capability_base_filter, next_capability_base_filter, view_image_tool_available, previous_view_image_visible, next_view_image_visible, previous_active_visibility_revision, previous_staged_visibility_revision, next_active_visibility_revision, tool_visibility_delta) == (meerkat_session_llm_visibility_shape_matches(previous_visibility_state, next_visibility_state, previous_capability_base_filter, next_capability_base_filter, previous_active_visibility_revision, previous_staged_visibility_revision, next_active_visibility_revision) /\ (previous_view_image_visible = meerkat_session_llm_visibility_state_allows_view_image(view_image_tool_available, previous_visibility_state)) /\ (next_view_image_visible = meerkat_session_llm_visibility_state_allows_view_image(view_image_tool_available, next_visibility_state)) /\ (next_active_visibility_revision = meerkat_session_llm_expected_next_visibility_revision((previous_view_image_visible # next_view_image_visible), previous_active_visibility_revision, previous_staged_visibility_revision)) /\ (next_active_visibility_revision >= previous_active_visibility_revision) /\ (next_visibility_state.staged_revision = meerkat_session_llm_expected_next_staged_visibility_revision((previous_view_image_visible # next_view_image_visible), previous_active_visibility_revision, previous_staged_visibility_revision, next_active_visibility_revision)) /\ meerkat_session_llm_visibility_delta_matches(tool_visibility_delta, previous_capability_base_filter, next_capability_base_filter, (previous_view_image_visible # next_view_image_visible)))
meerkat_session_llm_capability_base_filter_replacement_matches(current_capability_surface, current_capability_surface_status, current_capability_base_filter, next_capability_base_filter) == (IF (current_capability_surface_status = "Resolved") THEN ((current_capability_surface # None) /\ meerkat_session_llm_capability_base_filter_matches((IF "value" \in DOMAIN current_capability_surface THEN current_capability_surface["value"] ELSE None), next_capability_base_filter)) ELSE (next_capability_base_filter = current_capability_base_filter))
meerkat_session_llm_hydrated_capability_base_filter_matches(current_capability_surface, current_capability_surface_status, current_capability_base_filter) == (IF (current_capability_surface_status = "Resolved") THEN ((current_capability_surface # None) /\ meerkat_session_llm_capability_base_filter_matches((IF "value" \in DOMAIN current_capability_surface THEN current_capability_surface["value"] ELSE None), current_capability_base_filter)) ELSE ((current_capability_surface = None) /\ (current_capability_base_filter.tag = "All")))
meerkat_machine_session_id_matches_string(current, candidate) ==
    current # None /\ current.value = candidate
meerkat_peer_endpoint_set_cardinality_matches(endpoints, endpoint_count) ==
    Cardinality(endpoints) = endpoint_count
meerkat_peer_endpoint_set_contains_peer_id(endpoints, peer_id) ==
    \E endpoint \in endpoints: endpoint.peer_id = peer_id
meerkat_peer_endpoint_option_peer_id_matches(endpoint, peer_id) ==
    endpoint # None /\ endpoint.value.peer_id = peer_id
meerkat_peer_endpoint_peer_id_matches(endpoint, peer_id) ==
    endpoint.peer_id = peer_id
meerkat_peer_endpoint_set_peer_ids_unique(endpoints) ==
    Cardinality(endpoints) = Cardinality({ endpoint.peer_id : endpoint \in endpoints })

