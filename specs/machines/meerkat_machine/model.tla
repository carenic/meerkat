StartConversationRunIdleWithBinding(run_id, arg_primitive_kind, arg_admitted_content_shape, arg_vision_enabled, arg_image_tool_results_enabled, arg_max_extraction_retries) ==
    /\ phase = "Idle"
    /\ (active_runtime_id # None)
    /\ (IF (turn_phase = "Ready") THEN TRUE ELSE (IF (turn_phase = "Completed") THEN TRUE ELSE (IF (turn_phase = "Failed") THEN TRUE ELSE (turn_phase = "Cancelled"))))
    /\ ((arg_primitive_kind = "ConversationTurn") /\ (IF (arg_admitted_content_shape = "conversation") THEN TRUE ELSE (arg_admitted_content_shape = "empty")))
    /\ (run_start_holds = {})
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ current_run_id' = Some(run_id)
    /\ pre_run_phase' = Some("Attached")
    /\ turn_phase' = "ApplyingPrimitive"
    /\ primitive_kind' = Some(arg_primitive_kind)
    /\ admitted_content_shape' = Some(arg_admitted_content_shape)
    /\ vision_enabled' = arg_vision_enabled
    /\ image_tool_results_enabled' = arg_image_tool_results_enabled
    /\ tool_calls_pending' = 0
    /\ pending_op_refs' = {}
    /\ barrier_operation_ids' = {}
    /\ has_barrier_ops' = FALSE
    /\ barrier_satisfied' = FALSE
    /\ boundary_count' = 0
    /\ cancel_after_boundary' = FALSE
    /\ boundary_cancel_dispatch_pending' = FALSE
    /\ turn_terminal_run_id' = None
    /\ terminal_outcome' = None
    /\ terminal_cause_kind' = None
    /\ last_runtime_apply_failure_cause' = None
    /\ last_runtime_apply_failure_message' = None
    /\ extraction_attempts' = 0
    /\ max_extraction_retries' = arg_max_extraction_retries
    /\ extraction_active' = FALSE
