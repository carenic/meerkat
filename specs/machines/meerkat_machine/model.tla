channel_id \in DOMAIN live_bridge_operation_by_channel THEN live_bridge_operation_by_channel[channel_id] ELSE "None")) ELSE None)["value"] ELSE None)] ELSE "None")) ELSE None) = Some("ExecutionRunning")) THEN live_bridge_phase_by_operation ELSE MapSet(live_bridge_phase_by_operation, (IF "value" \in DOMAIN (IF (channel_id \in DOMAIN live_bridge_operation_by_channel) THEN Some((IF channel_id \in DOMAIN live_bridge_operation_by_channel THEN live_bridge_operation_by_channel[channel_id] ELSE "None")) ELSE None) THEN (IF (channel_id \in DOMAIN live_bridge_operation_by_channel) THEN Some((IF channel_id \in DOMAIN live_bridge_operation_by_channel THEN live_bridge_operation_by_channel[channel_id] ELSE "None")) ELSE None)["value"] ELSE None), "ExecutionTerminal") ELSE live_bridge_phase_by_operation ELSE live_bridge_phase_by_operation
