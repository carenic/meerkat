    /\ (IF ~((replacement_channel_id \in DOMAIN live_context_reserved_cursor_by_channel)) THEN TRUE ELSE (canonical_seed_cursor = 0))
    /\ ((IF ~((replacement_channel_id \in DOMAIN live_webrtc_answer_observation_sequence_by_channel)) THEN TRUE ELSE (replacement_channel_id \in DOMAIN live_webrtc_answer_observation_sequence_by_channel)) /\ (IF ~((replacement_channel_id \in DOMAIN live_webrtc_answer_observation_sequence_by_channel)) THEN TRUE ELSE (answer_observation_sequence > (live_webrtc_answer_observation_sequence_by_channel)[replacement_channel_id])))
