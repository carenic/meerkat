    /\ phase = "Idle"
    /\ (model_routing_operation_override_id = Some(operation_id))
    /\ (operation_id \in DOMAIN model_routing_image_operation_requires_scoped_override)
    /\ ((IF (operation_id \in DOMAIN model_routing_image_classified_terminals) THEN Some((IF operation_id \in DOMAIN model_routing_image_classified_terminals THEN model_routing_image_classified_terminals[operation_id] ELSE "None")) ELSE None) = Some(terminal))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ model_routing_image_operation_phases' = MapSet(model_routing_image_operation_phases, operation_id, "RestoringScopedOverride")
    /\ model_routing_image_classified_terminals' = MapRemove(model_routing_image_classified_terminals, operation_id)
    /\ model_routing_image_classified_provider_text' = MapRemove(model_routing_image_classified_provider_text, operation_id)
    /\ model_routing_image_terminals' = MapSet(model_routing_image_terminals, operation_id, terminal)
