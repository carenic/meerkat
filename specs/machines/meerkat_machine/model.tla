    /\ op_statuses' = MapSet(op_statuses, operation_id, "Completed")
    /\ op_completion_seq' = MapSet(op_completion_seq, operation_id, (next_completion_seq) + 1)
    /\ completion_sequence_claims' = (completion_sequence_claims \cup {(next_completion_seq) + 1})
