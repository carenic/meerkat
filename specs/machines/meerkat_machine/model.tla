fence_requires_bound_runtime == (IF (active_fence_token = None) THEN TRUE ELSE (active_runtime_id # None))
runtime_generation_requires_bound_runtime == (IF (active_runtime_generation = None) THEN TRUE ELSE (active_runtime_id # None))
runtime_epoch_requires_registered_session == (IF (active_runtime_epoch_id = None) THEN TRUE ELSE (session_id # None))
runtime_binding_identity_is_typed == (IF (active_runtime_id = None) THEN TRUE ELSE (IF (active_runtime_generation # None) THEN TRUE ELSE (active_runtime_epoch_id # None)))
running_has_current_run == (IF (phase # "Running") THEN TRUE ELSE (current_run_id # None))
deferred_stop_requires_active_runtime_phase == (IF (runtime_stop_deferred = FALSE) THEN TRUE ELSE (IF (phase = "Running") THEN TRUE ELSE (phase = "Attached")))
unregister_drain_obligations_require_draining == (IF (registration_phase = "Draining") THEN TRUE ELSE ((unregister_runtime_loop_drain_pending = FALSE) /\ (unregister_comms_drain_exit_pending = FALSE) /\ (unregister_completion_waiter_drain_pending = FALSE) /\ (unregister_teardown_retains_snapshot = FALSE)))
current_run_only_while_running_or_retired == (IF (current_run_id = None) THEN TRUE ELSE (IF (phase = "Running") THEN TRUE ELSE (phase = "Retired")))
current_run_has_pre_run_phase == (IF ((current_run_id = None) /\ (pre_run_phase = None)) THEN TRUE ELSE ((current_run_id # None) /\ (pre_run_phase # None)))
staged_inputs_are_not_queued == (\A input_id \in DOMAIN input_phases : (IF ((IF input_id \in DOMAIN input_phases THEN input_phases[input_id] ELSE "None") # "Staged") THEN TRUE ELSE ~((input_id \in DOMAIN input_lane))))
staged_inputs_have_run_association == (\A input_id \in DOMAIN input_phases : (IF ((IF input_id \in DOMAIN input_phases THEN input_phases[input_id] ELSE "None") # "Staged") THEN TRUE ELSE (input_id \in DOMAIN input_run_associations)))
staged_surface_ops_are_known_and_sequenced == (\A surface_id \in DOMAIN surface_staged_op : ((surface_id \in known_surfaces) /\ (surface_id \in DOMAIN surface_staged_intent_sequence)))
staged_reload_surfaces_are_active == (\A surface_id \in reload_staged_surfaces : (surface_id \in active_surfaces))
peer_ingress_owner_consistency == (IF ((peer_ingress_owner_kind = "Unattached") /\ (peer_ingress_comms_runtime_id = None) /\ (peer_ingress_mob_id = None)) THEN TRUE ELSE (IF ((peer_ingress_owner_kind = "SessionOwned") /\ (peer_ingress_comms_runtime_id # None) /\ (peer_ingress_mob_id = None)) THEN TRUE ELSE ((peer_ingress_owner_kind = "MobOwned") /\ (peer_ingress_comms_runtime_id # None) /\ (peer_ingress_mob_id # None))))
supervisor_binding_consistency == (IF ((supervisor_binding_kind = "Unbound") /\ (supervisor_bound_name = None) /\ (supervisor_bound_peer_id = None) /\ (supervisor_bound_address = None) /\ (supervisor_bound_signing_public_key = None) /\ (supervisor_bound_epoch = None)) THEN TRUE ELSE ((supervisor_binding_kind = "Bound") /\ (supervisor_bound_name # None) /\ (supervisor_bound_peer_id # None) /\ (supervisor_bound_address # None) /\ (supervisor_bound_signing_public_key # None) /\ (supervisor_bound_epoch # None)))
supervisor_revoke_pending_consistency == (IF ((supervisor_revoke_pending_name = None) /\ (supervisor_revoke_pending_peer_id = None) /\ (supervisor_revoke_pending_address = None) /\ (supervisor_revoke_pending_signing_public_key = None) /\ (supervisor_revoke_pending_epoch = None)) THEN TRUE ELSE ((supervisor_revoke_pending_name # None) /\ (supervisor_revoke_pending_peer_id # None) /\ (supervisor_revoke_pending_address # None) /\ (supervisor_revoke_pending_signing_public_key # None) /\ (supervisor_revoke_pending_epoch # None)))
supervisor_revoked_receipt_consistency == (IF ((supervisor_revoked_peer_id = None) /\ (supervisor_revoked_signing_public_key = None) /\ (supervisor_revoked_epoch = None)) THEN TRUE ELSE ((supervisor_revoked_peer_id # None) /\ (supervisor_revoked_signing_public_key # None) /\ (supervisor_revoked_epoch # None)))
supervisor_live_binding_excludes_revoked_receipt == (IF (supervisor_binding_kind # "Bound") THEN TRUE ELSE (supervisor_revoked_peer_id = None))
supervisor_authority_is_closed == (IF ((supervisor_binding_kind = "Bound") /\ (supervisor_revoke_pending_peer_id = None) /\ (supervisor_revoked_peer_id = None)) THEN TRUE ELSE (IF ((supervisor_binding_kind = "Unbound") /\ (supervisor_revoke_pending_peer_id # None) /\ (supervisor_revoked_peer_id = None)) THEN TRUE ELSE ((supervisor_binding_kind = "Unbound") /\ (supervisor_revoke_pending_peer_id = None))))
supervisor_publish_pending_consistency == (IF ((supervisor_publish_pending_name = None) /\ (supervisor_publish_pending_peer_id = None) /\ (supervisor_publish_pending_address = None) /\ (supervisor_publish_pending_signing_public_key = None) /\ (supervisor_publish_pending_epoch = None)) THEN TRUE ELSE ((supervisor_publish_pending_name # None) /\ (supervisor_publish_pending_peer_id # None) /\ (supervisor_publish_pending_address # None) /\ (supervisor_publish_pending_signing_public_key # None) /\ (supervisor_publish_pending_epoch # None)))
supervisor_rotation_receipt_consistency == (IF ((supervisor_rotation_operation_id = None) /\ (supervisor_rotation_phase = None) /\ (supervisor_rotation_rejection = None) /\ (supervisor_rotation_previous_name = None) /\ (supervisor_rotation_previous_peer_id = None) /\ (supervisor_rotation_previous_address = None) /\ (supervisor_rotation_previous_signing_public_key = None) /\ (supervisor_rotation_previous_epoch = None) /\ (supervisor_rotation_next_name = None) /\ (supervisor_rotation_next_peer_id = None) /\ (supervisor_rotation_next_address = None) /\ (supervisor_rotation_next_signing_public_key = None) /\ (supervisor_rotation_next_epoch = None)) THEN TRUE ELSE ((supervisor_rotation_operation_id # None) /\ (supervisor_rotation_phase # None) /\ (supervisor_rotation_previous_name # None) /\ (supervisor_rotation_previous_peer_id # None) /\ (supervisor_rotation_previous_address # None) /\ (supervisor_rotation_previous_signing_public_key # None) /\ (supervisor_rotation_previous_epoch # None) /\ (supervisor_rotation_next_name # None) /\ (supervisor_rotation_next_peer_id # None) /\ (supervisor_rotation_next_address # None) /\ (supervisor_rotation_next_signing_public_key # None) /\ (supervisor_rotation_next_epoch # None) /\ (IF ((supervisor_rotation_phase = Some("Rejected")) /\ (supervisor_rotation_rejection # None)) THEN TRUE ELSE ((supervisor_rotation_phase # Some("Rejected")) /\ (supervisor_rotation_rejection = None)))))
