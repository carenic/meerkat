    /\ ((IF (channel_id \in DOMAIN live_channel_session_by_channel) THEN Some((IF channel_id \in DOMAIN live_channel_session_by_channel THEN live_channel_session_by_channel[channel_id] ELSE "None")) ELSE None) = Some(arg_session_id))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ live_open_admission_sequence' = (live_open_admission_sequence) + 1
    /\ live_active_channel_by_session' = MapRemove(live_active_channel_by_session, arg_session_id)
    /\ live_channel_session_by_channel' = MapRemove(live_channel_session_by_channel, channel_id)
