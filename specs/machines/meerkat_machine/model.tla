    /\ ((input_kind = "PeerResponseProgress") /\ (silent_intent_match = FALSE))
    /\ (IF (existing_superseded_input_id = None) THEN TRUE ELSE ((IF "value" \in DOMAIN existing_superseded_input_id THEN existing_superseded_input_id["value"] ELSE None) \in DOMAIN input_phases))
