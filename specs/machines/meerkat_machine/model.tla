    /\ phase = "Running"
    /\ (current_run_id = Some(run_id))
    /\ (IF (turn_phase = "CallingLlm") THEN TRUE ELSE (IF (turn_phase = "WaitingForOps") THEN TRUE ELSE (IF (turn_phase = "DrainingBoundary") THEN TRUE ELSE (turn_phase = "Extracting"))))
