PublishCommittedVisibleSetIdle(arg_active_filter, arg_staged_filter, active_requested_deferred_names, staged_requested_deferred_names, arg_active_deferred_authorities, arg_staged_deferred_authorities, arg_active_visibility_revision, arg_staged_visibility_revision) ==
    /\ phase = "Idle"
    /\ (session_id # None)
    /\ (arg_active_visibility_revision >= arg_staged_visibility_revision)
    /\ (IF (arg_active_visibility_revision # arg_staged_visibility_revision) THEN TRUE ELSE ((arg_active_filter = arg_staged_filter) /\ (active_requested_deferred_names = staged_requested_deferred_names) /\ (arg_active_deferred_authorities = arg_staged_deferred_authorities)))
    /\ (\A requested_name \in active_requested_deferred_names : (requested_name \in staged_requested_deferred_names))
    /\ (\A requested_name \in active_requested_deferred_names : (requested_name \in DOMAIN arg_active_deferred_authorities))
    /\ (\A requested_name \in staged_requested_deferred_names : (requested_name \in DOMAIN arg_staged_deferred_authorities))
    /\ (\A witnessed_name \in DOMAIN arg_active_deferred_authorities : (witnessed_name \in active_requested_deferred_names))
    /\ (\A witnessed_name \in DOMAIN arg_staged_deferred_authorities : (witnessed_name \in staged_requested_deferred_names))
    /\ deferred_authorities_have_identity(active_requested_deferred_names, arg_active_deferred_authorities)
    /\ deferred_authorities_have_identity(staged_requested_deferred_names, arg_staged_deferred_authorities)
    /\ meerkat_tool_visibility_publish_matches_catalog(arg_active_filter, arg_staged_filter, arg_active_deferred_authorities, arg_staged_deferred_authorities, filter_visibility_witnesses, deferred_visibility_authority_catalog, filter_visibility_authority_catalog)
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ next_staged_visibility_revision' = IF (arg_active_visibility_revision > next_staged_visibility_revision) THEN arg_active_visibility_revision ELSE next_staged_visibility_revision
    /\ active_filter' = arg_active_filter
    /\ staged_filter' = arg_staged_filter
    /\ active_visibility_revision' = arg_active_visibility_revision
    /\ staged_visibility_revision' = arg_staged_visibility_revision
    /\ active_deferred_names' = active_requested_deferred_names
    /\ staged_deferred_names' = staged_requested_deferred_names
    /\ active_deferred_authorities' = arg_active_deferred_authorities
    /\ staged_deferred_authorities' = arg_staged_deferred_authorities
    /\ UnchangedFrame_df4e95206316d18e


