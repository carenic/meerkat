FatalFailure(run_id, terminal_failure_source, error) ==
    /\ phase = "Running"
    /\ (current_run_id = Some(run_id))
    /\ ((turn_phase # "Completed") /\ (turn_phase # "Failed") /\ (turn_phase # "Cancelled"))
    /\ (terminal_failure_source # "Unknown")
    /\ (terminal_failure_source # "MaxTurnsReached")
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ turn_phase' = "Failed"
    /\ turn_terminal_run_id' = Some(run_id)
    /\ terminal_outcome' = Some((IF (IF (terminal_failure_source = "TokenBudgetExceeded") THEN TRUE ELSE (terminal_failure_source = "ToolCallBudgetExceeded")) THEN "BudgetExhausted" ELSE (IF (terminal_failure_source = "TimeBudgetExceeded") THEN "TimeBudgetExceeded" ELSE (IF (IF (terminal_failure_source = "StructuredOutputValidationFailed") THEN TRUE ELSE (terminal_failure_source = "InvalidOutputSchema")) THEN "StructuredOutputValidationFailed" ELSE "Failed"))))
    /\ terminal_cause_kind' = Some((IF (terminal_failure_source = "HookDenied") THEN "HookDenied" ELSE (IF (IF (terminal_failure_source = "HookTimeout") THEN TRUE ELSE (IF (terminal_failure_source = "HookExecutionFailed") THEN TRUE ELSE (terminal_failure_source = "HookConfigInvalid"))) THEN "HookFailure" ELSE (IF (terminal_failure_source = "Llm") THEN "LlmFailure" ELSE (IF (IF (terminal_failure_source = "ToolError") THEN TRUE ELSE (terminal_failure_source = "InvalidToolAccess")) THEN "ToolFailure" ELSE (IF (IF (terminal_failure_source = "StructuredOutputValidationFailed") THEN TRUE ELSE (terminal_failure_source = "InvalidOutputSchema")) THEN "StructuredOutputValidationFailed" ELSE (IF (IF (terminal_failure_source = "TokenBudgetExceeded") THEN TRUE ELSE (terminal_failure_source = "ToolCallBudgetExceeded")) THEN "BudgetExhausted" ELSE (IF (terminal_failure_source = "TimeBudgetExceeded") THEN "TimeBudgetExceeded" ELSE (IF (terminal_failure_source = "LlmRetryExhausted") THEN "RetryExhausted" ELSE (IF (terminal_failure_source = "MaxTurnsReached") THEN "TurnLimitReached" ELSE "FatalFailure"))))))))))
    /\ extraction_active' = FALSE
    /\ UnchangedFrame_b1457f94a60a7c06


