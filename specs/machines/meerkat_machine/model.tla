    /\ (IF (active_runtime_id = None) THEN TRUE ELSE (IF (active_runtime_epoch_id = previous_runtime_epoch_id) THEN TRUE ELSE (IF ((IF "value" \in DOMAIN active_fence_token THEN active_fence_token["value"] ELSE None) > previous_fence_token) THEN TRUE ELSE ((IF "value" \in DOMAIN active_runtime_generation THEN active_runtime_generation["value"] ELSE None) > previous_runtime_generation))))
