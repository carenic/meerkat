CommitStickyModelFallbackRunning(previous_identity, previous_visibility_state, target_identity, target_model, target_profile_provider, target_profile_model, target_capability_surface, target_capability_surface_status, target_capability_base_filter, target_realtime_capable, view_image_tool_available, previous_view_image_visible, next_view_image_visible, previous_active_visibility_revision, previous_staged_visibility_revision, next_visibility_state, next_active_visibility_revision, tool_visibility_delta, retry_attempt) ==
    /\ phase = "Running"
    /\ (session_id # None)
    /\ (turn_phase = "ErrorRecovery")
    /\ (retry_attempt = llm_retry_attempt)
    /\ (current_session_llm_identity = Some(previous_identity))
    /\ ((previous_visibility_state.capability_base_filter = current_session_capability_base_filter) /\ (previous_visibility_state.inherited_base_filter = inherited_base_filter) /\ (previous_visibility_state.active_filter = active_filter) /\ (previous_visibility_state.staged_filter = staged_filter) /\ (previous_visibility_state.active_requested_deferred_names = active_deferred_names) /\ (previous_visibility_state.staged_requested_deferred_names = staged_deferred_names) /\ (previous_visibility_state.active_revision = active_visibility_revision) /\ (previous_visibility_state.staged_revision = staged_visibility_revision) /\ (previous_visibility_state.requested_witnesses = requested_visibility_witnesses) /\ (previous_visibility_state.filter_witnesses = filter_visibility_witnesses))
    /\ (target_identity.model = target_model)
    /\ (meerkat_session_llm_profile_provenance_matches(target_identity, target_profile_provider, target_profile_model, target_capability_surface_status) = TRUE)
    /\ (meerkat_session_llm_hydrated_capability_base_filter_matches(target_capability_surface, target_capability_surface_status, target_capability_base_filter) = TRUE)
    /\ (meerkat_session_llm_visibility_reconfigure_plan_matches(previous_visibility_state, next_visibility_state, previous_visibility_state.capability_base_filter, target_capability_base_filter, view_image_tool_available, previous_view_image_visible, next_view_image_visible, previous_active_visibility_revision, previous_staged_visibility_revision, next_active_visibility_revision, tool_visibility_delta) = TRUE)
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ model_routing_baseline_model' = Some(target_model)
    /\ model_routing_baseline_realtime' = Some(target_realtime_capable)
    /\ model_routing_topology_epoch' = (model_routing_topology_epoch + 1)
    /\ current_session_llm_identity' = Some(target_identity)
    /\ current_session_capability_surface' = target_capability_surface
    /\ current_session_capability_surface_status' = target_capability_surface_status
    /\ current_session_capability_base_filter' = target_capability_base_filter
    /\ next_staged_visibility_revision' = IF (next_visibility_state.staged_revision > IF (next_active_visibility_revision > next_staged_visibility_revision) THEN next_active_visibility_revision ELSE next_staged_visibility_revision) THEN next_visibility_state.staged_revision ELSE IF (next_active_visibility_revision > next_staged_visibility_revision) THEN next_active_visibility_revision ELSE next_staged_visibility_revision
    /\ inherited_base_filter' = next_visibility_state.inherited_base_filter
    /\ active_filter' = next_visibility_state.active_filter
    /\ staged_filter' = next_visibility_state.staged_filter
    /\ active_visibility_revision' = next_active_visibility_revision
    /\ staged_visibility_revision' = next_visibility_state.staged_revision
    /\ active_deferred_names' = next_visibility_state.active_requested_deferred_names
    /\ staged_deferred_names' = next_visibility_state.staged_requested_deferred_names
    /\ requested_visibility_witnesses' = next_visibility_state.requested_witnesses
    /\ filter_visibility_witnesses' = next_visibility_state.filter_witnesses
    /\ UnchangedFrame_f0305b77447c3064


