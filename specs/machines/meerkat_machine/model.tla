    /\ current_session_llm_identity' = Some(target_identity)
    /\ current_session_capability_surface' = target_capability_surface
    /\ current_session_capability_surface_status' = target_capability_surface_status
    /\ current_session_capability_base_filter' = target_capability_base_filter
    /\ next_staged_visibility_revision' = IF (next_visibility_state.staged_revision > IF (next_active_visibility_revision > next_staged_visibility_revision) THEN next_active_visibility_revision ELSE next_staged_visibility_revision) THEN next_visibility_state.staged_revision ELSE IF (next_active_visibility_revision > next_staged_visibility_revision) THEN next_active_visibility_revision ELSE next_staged_visibility_revision
