    /\ phase = "Running"
    /\ (IF (status = "Completed") THEN TRUE ELSE (IF (status = "Failed") THEN TRUE ELSE (status = "Canceled")))
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ UnchangedFrame_581add88d467e51b


ClassifyFlowRunTerminalityNonTerminalRunning(run_id, status) ==
    /\ phase = "Running"
    /\ (IF (status = "Absent") THEN TRUE ELSE (IF (status = "Pending") THEN TRUE ELSE (status = "Running")))
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ UnchangedFrame_581add88d467e51b


ClassifyFlowStepTerminalityTerminalRunning(run_id, step_id, status) ==
    /\ phase = "Running"
    /\ (IF (status = "Completed") THEN TRUE ELSE (IF (status = "Failed") THEN TRUE ELSE (IF (status = "Skipped") THEN TRUE ELSE (status = "Canceled"))))
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ UnchangedFrame_581add88d467e51b


