    /\ (IF ((host_id \in DOMAIN host_bind_phase) = TRUE) THEN TRUE ELSE ((host_id \in DOMAIN replacement_host_bind_endpoints) = TRUE))
    /\ (IF ((IF (host_id \in DOMAIN host_binding_generations) THEN Some((IF host_id \in DOMAIN host_binding_generations THEN host_binding_generations[host_id] ELSE 0)) ELSE None) = Some(binding_generation)) THEN TRUE ELSE ((IF (host_id \in DOMAIN replacement_host_binding_generations) THEN Some((IF host_id \in DOMAIN replacement_host_binding_generations THEN replacement_host_binding_generations[host_id] ELSE 0)) ELSE None) = Some(binding_generation)))
    /\ mob_machine_placed_kickoff_custody_absent_for_host(pending_placed_kickoff_outcomes, resolved_placed_kickoff_outcomes, host_id)
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ mob_hosts' = (mob_hosts \ {host_id})
    /\ host_public_keys' = MapRemove(host_public_keys, host_id)
    /\ host_endpoints' = MapRemove(host_endpoints, host_id)
    /\ host_authority_epochs' = MapRemove(host_authority_epochs, host_id)
