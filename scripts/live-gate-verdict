#!/usr/bin/env python3
"""Turn one live-gate Bazel run into a typed verdict.

usage: scripts/live-gate-verdict <bazel-log> <bazel-exit-code>

The lane runs every GPT Live scenario exactly once (no Bazel retry), with
--test_output=errors, so each failed run prints one
"==== Test output for //:<target>:" section ("... (run N of M):" when a
target runs more than once). A failed section is VOID when it carries one of
two provider signatures; VOID is neither green nor red, it says nothing
about the change:
- provider degraded: the scenario's typed verdict (GPT_LIVE_VERDICT ...
  verdict=provider_degraded, emitted by Journal::provider_degraded_verdict
  when the provider's input transcription lagged past the measured
  threshold);
- provider stalled after it started speaking (provider_stalled below): the
  provider began an answer, then sent only silent audio until the scenario
  timed out waiting for it, and nothing in the run shows the product
  holding, muting or ending that answer.
Any other failed section is RED.

Exit codes:
  0  GREEN: Bazel succeeded and no run failed.
  1  RED: at least one run failed for a reason other than those two, or
     Bazel failed without any test output (a build failure).
  3  VOID: every failed run was void. There is no green evidence, so the
     gate does not pass; re-run it in a healthy provider window. A void
     never turns red into green.
"""

from __future__ import annotations

import re
import sys

# Bazel prints "(run N of M)" only when a target runs more than once; the
# gate's single run prints the bare target.
SECTION = re.compile(r"^=+ Test output for (//[^\s:]*:[^\s:]+)(?: \(run (\d+) of (\d+)\))?:\s*$")
SECTION_END = re.compile(r"^={40,}\s*$")
DEGRADED = re.compile(r"GPT_LIVE_VERDICT .*verdict=provider_degraded|PROVIDER_DEGRADED: ")

# The provider-stall signature (S98 in run 39209102955). The harness's wait
# for spoken output timed out while the provider's RTP packets kept arriving
# (packets_received > 0) and decoded to silence: no audible decoded frame and
# zero total audio energy. The harness counts decoded frames on the raw
# remote track, ahead of the playback gate (the duck), so with a working
# track processor this is silence at the source. The counters cover the
# browser peer's whole life, so the class only covers an answer on a peer
# that never played audible audio, such as the first answer after an open or
# a reopen.
SPOKEN_OUTPUT_TIMEOUT = re.compile(
    r"timed out waiting for spoken output; "
    r"(?=.*\bdecoded_frames=[1-9])"
    r"(?=.*\bdecoded_non_silent_frames=0\b)"
    r"(?=.*\bprocessor_supported=true\b)"
    r"(?=.*\bprocessor_errors=0\b)"
    r"(?=.*\bnon_silent_frames=0\b)"
    r"(?=.*\bpackets_received=[1-9])"
    r"(?=.*\btotal_audio_energy=Some\(0(?:\.0+)?\))"
)
# A sideband observation the broker lowered from the provider's stream.
OBSERVATION = re.compile(r'GptLiveBrokerObservation \{ kind: "([a-z_]+)"')
# A line the broker logged, by its tracing target or its message prefix.
BROKER_TARGET = "meerkat_openai::public_live: "
BROKER_LINE = re.compile(r"\bmeerkat_openai::public_live: |\bpublic Live ")
# The only observations a provider that stalls in its answer leaves behind:
# the answer's transcript, its snapshot deltas and the provider's input clock.
QUIET_KINDS = frozenset({"assistant_transcript_fragment", "turn_snapshot_delta", "provider_input_latency"})
# The provider's reflected output stream kept arriving, so its session was
# alive. The stream runs continuously, silence included: it says nothing
# about whether the answer was audible.
REFLECTED_OUTPUT_AUDIO = re.compile(r"public Live sideband reflected output audio ")
# The product held a typed text-chat row because it measured the model's
# response as audible, or released one: it saw audible output.
TEXT_CHAT_HOLD = re.compile(r"public Live (?:text-chat context held|held text-chat context released)")
# The channel closed or its observation stream ended.
CHANNEL_END = re.compile(r"\bmeerkat::live_close: |experimental live adapter observation stream ended")
# The adapter's tracing target. A stream end is logged there, so its absence
# only counts when the run logs that target at all.
ADAPTER_TARGET = re.compile(r"\bmeerkat::experimental_gpt_live: ")
# The product's playback gate: user speech over the assistant ducks the
# browser's playback, and a restorable playback lifts the duck.
DUCK = "user_speech_over_assistant"
RESTORE = "assistant_playback_restorable"


def provider_stalled(lines: list[str]) -> bool:
    """The provider started its answer, then went silent upstream.

    Every condition must hold; any other spoken-output timeout stays RED:
    - the scenario timed out waiting for spoken output while the provider's
      packets kept arriving and decoded to silence (SPOKEN_OUTPUT_TIMEOUT);
    - the run holds or releases no text-chat context anywhere, and it logs
      the adapter's target, so a stream end would show;
    - the playback gate was open when the last turn the provider started
      began (no duck, or the last duck restored);
    - after that turn started, the broker lowered assistant transcript on its
      own target (the answer began) and no observation outside QUIET_KINDS
      (no finished turn, user speech, duck or restore, append receipt or
      delegation activity); it logged nothing besides those observations and
      reflected output audio (no send, hold, release, acknowledgement or
      notice); its reflected output kept arriving (the session was alive);
      and the channel neither closed nor ended its observation stream.
    A context append the provider never acknowledged leaves no line, so the
    signature cannot see one.
    """
    if not any(SPOKEN_OUTPUT_TIMEOUT.search(line) for line in lines):
        return False
    if any(TEXT_CHAT_HOLD.search(line) for line in lines):
        return False
    if not any(ADAPTER_TARGET.search(line) for line in lines):
        return False
    kinds = [_kind(line) for line in lines]
    started = [index for index, kind in enumerate(kinds) if kind == "turn_started"]
    if not started:
        return False
    answer = started[-1]
    gate_before = [kind for kind in kinds[:answer] if kind in (DUCK, RESTORE)]
    if gate_before and gate_before[-1] == DUCK:
        return False
    answered = alive = False
    for line, kind in zip(lines[answer + 1 :], kinds[answer + 1 :]):
        if CHANNEL_END.search(line):
            return False
        if kind is not None:
            if kind not in QUIET_KINDS:
                return False
            answered = answered or (kind == "assistant_transcript_fragment" and BROKER_TARGET in line)
        elif REFLECTED_OUTPUT_AUDIO.search(line):
            alive = True
        elif BROKER_LINE.search(line):
            return False
    return answered and alive


def _kind(line: str) -> str | None:
    match = OBSERVATION.search(line)
    return match.group(1) if match else None


def void_reason(lines: list[str]) -> str | None:
    if any(DEGRADED.search(line) for line in lines):
        return "provider degraded"
    if provider_stalled(lines):
        return "provider stalled after it started speaking"
    return None


def main() -> int:
    if len(sys.argv) != 3:
        print(__doc__, file=sys.stderr)
        return 1
    log_path, bazel_exit = sys.argv[1], int(sys.argv[2])
    sections = []
    current = None
    with open(log_path, encoding="utf-8", errors="replace") as log:
        for line in log:
            line = line.rstrip("\n")
            start = SECTION.match(line)
            if start:
                current = {"target": start.group(1), "run": start.group(2) or "1", "lines": []}
                sections.append(current)
                continue
            if current is not None:
                if SECTION_END.match(line):
                    current = None
                else:
                    current["lines"].append(line)
    for section in sections:
        section["void"] = void_reason(section["lines"])

    red = [s for s in sections if s["void"] is None]
    void = [s for s in sections if s["void"] is not None]
    for s in red:
        print(f"RED  {s['target']} run {s['run']}")
    for s in void:
        print(f"VOID {s['target']} run {s['run']} ({s['void']})")

    if red:
        print(f"live gate: RED ({len(red)} failed run(s), {len(void)} void)")
        return 1
    if bazel_exit != 0 and not void:
        print(f"live gate: RED (Bazel exited {bazel_exit} without test output: build or infrastructure failure)")
        return 1
    if void:
        print(f"live gate: VOID ({len(void)} void run(s), no other failure); re-run in a healthy provider window")
        return 3
    print("live gate: GREEN")
    return 0


if __name__ == "__main__":
    sys.exit(main())
