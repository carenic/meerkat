#!/usr/bin/env bash
# check-release-binary-markers: refuse a release binary that carries test-only
# code.
#
# Each marker is a string that only compiled-in test code contains: a string
# literal inside a test hook, the name of a test-only static, or the text of a
# test-only log line. No release binary may contain one. Plain names that
# documentation may mention (environment variables, feature names) are not
# markers: the binaries embed the help corpus. The release packaging runs this
# on every binary before archiving it, and the publisher again on the exact
# bytes it publishes. scripts/test_check_release_binary_markers.py binds every
# workspace marker to its gated source and keeps the docs and the embedded
# help corpus free of them.
#
# Usage: [VERSION=X.Y.Z] check-release-binary-markers <binary>...
#        check-release-binary-markers --list       (marker|source|gate, one per line)
# Exit 0 = no marker (but the one a release before 0.9.2 may carry, below),
# 1 = a binary carries test-only code, 2 = usage or read error.

set -euo pipefail

# marker|source that compiles it in|the gate it compiles under
MARKERS=(
  "time is not frozen|external:tokio src/time/clock.rs|tokio feature test-util"
  "WHOLE_BLOB_DECODES_BY_SESSION|crates/meerkat-core/src/digest_observability.rs|feature test-support"
  "injected pre-commit failure|crates/meerkat-live/src/host.rs|feature test-support"
  "injected post-commit receipt failure|crates/meerkat-live/src/host.rs|feature test-support"
  "scripted input persistence acknowledgement lost after commit|crates/meerkat-runtime/src/store/sqlite.rs|feature test-support"
  "forced mob event store|crates/meerkat-mob/src/store/in_memory.rs|feature test-support"
  "injected delivery input settle cancellation failure|crates/meerkat-mob/src/runtime/delivery_wait.rs|feature test-support"
  "deterministic TestClient replaces the provider client|crates/meerkat/src/factory.rs|debug_assertions"
  "OAuth endpoints redirected to the local test fixture|crates/meerkat-auth-core/src/oauth_flow.rs|debug_assertions"
)

# tokio's test-util marker is allowed in the binaries of a release before
# 0.9.2 and nowhere else. Until 0.9.2 the Bazel (BuildBuddy) release builds
# compiled tokio's test-util feature: crate_universe resolves one feature set
# per external crate across every dependency kind, dev included. 0.9.2 moved
# it behind the release select (scripts/non-shipping-features.json,
# external_crate_features). Asset recovery of an older tag runs this guard
# from the workflow's ref, so the release version decides: the release
# workflow's packaging and publishing steps pass it as VERSION (X.Y.Z or
# vX.Y.Z; a prerelease counts as its release). With VERSION unset or
# unparsable, or 0.9.2 and later, the marker fails like every other one, and
# it never masks another.
LEGACY_MARKER="time is not frozen"
LEGACY_MARKER_UNTIL="0.9.2"

# Succeeds when VERSION names a release before LEGACY_MARKER_UNTIL.
legacy_marker_allowed() {
  local version="${VERSION-}"
  local pattern='^v?(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})(-[0-9A-Za-z.-]+)?$'
  [[ "${version}" =~ ${pattern} ]] || return 1
  local major="${BASH_REMATCH[1]}" minor="${BASH_REMATCH[2]}" patch="${BASH_REMATCH[3]}"
  local until_major until_minor until_patch
  IFS=. read -r until_major until_minor until_patch <<<"${LEGACY_MARKER_UNTIL}"
  ((major < until_major ||
    (major == until_major && (minor < until_minor ||
      (minor == until_minor && patch < until_patch)))))
}

if [[ $# -eq 0 ]]; then
  echo "usage: check-release-binary-markers <binary>... | --list" >&2
  exit 2
fi

if [[ "$1" == "--list" ]]; then
  printf '%s\n' "${MARKERS[@]}"
  exit 0
fi

patterns=()
for entry in "${MARKERS[@]}"; do
  patterns+=(-e "${entry%%|*}")
done

legacy_allowed=0
if legacy_marker_allowed; then
  legacy_allowed=1
fi

status=0
for binary in "$@"; do
  if [[ ! -f "${binary}" || ! -r "${binary}" ]]; then
    echo "check-release-binary-markers: cannot read ${binary}" >&2
    exit 2
  fi
  set +e
  found="$(LC_ALL=C grep -a -o -F "${patterns[@]}" -- "${binary}")"
  rc=$?
  set -e
  if [[ "${rc}" -gt 1 ]]; then
    echo "check-release-binary-markers: grep failed on ${binary} (exit ${rc})" >&2
    exit 2
  fi
  failed=0
  allowed=0
  if [[ "${rc}" -eq 0 ]]; then
    for entry in "${MARKERS[@]}"; do
      marker="${entry%%|*}"
      rest="${entry#*|}"
      grep -qxF -- "${marker}" <<<"${found}" || continue
      if [[ "${marker}" == "${LEGACY_MARKER}" && "${legacy_allowed}" -eq 1 ]]; then
        echo "notice: ${binary} carries the allowed marker \"${marker}\" (${rest%%|*}, ${rest#*|}; allowed for release ${VERSION} only: Bazel release builds before ${LEGACY_MARKER_UNTIL} compiled it)"
        allowed=1
        continue
      fi
      failed=1
      echo "error: ${binary} carries test-only code: \"${marker}\" (${rest%%|*}, ${rest#*|})" >&2
      if [[ "${marker}" == "${LEGACY_MARKER}" ]]; then
        echo "  only a release before ${LEGACY_MARKER_UNTIL} may carry it, and VERSION (${VERSION-unset}) does not name one" >&2
      fi
    done
  fi
  if [[ "${failed}" -eq 1 ]]; then
    status=1
  elif [[ "${allowed}" -eq 1 ]]; then
    echo "no test-only markers in ${binary} beyond the one allowed for ${VERSION}"
  else
    echo "no test-only markers in ${binary}"
  fi
done
exit "${status}"
