#!/usr/bin/env python3
"""Refuse to publish binaries compiled from a tree whose built-binary test
hooks reach release builds.

The RKAT_TEST_CLIENT shim (swaps in the deterministic TestClient) and the
OAuth fixture endpoint override (points OAuth at a local fixture) read
environment variables. Before 0.9.1 every release binary honoured both, and
such a binary carries no string that only test code contains: the variable
names alone also appear where documentation mentions them, so the packaged
binary marker scan cannot tell. verify-release-asset-provenance binds every
archive the publisher accepts to the release tag's tree; this script checks
that tree compiles each hook only under debug assertions or tests, so
archives built from an older tree (asset recovery of an old tag, or the
reused archives of an earlier run) fail closed.

Each string literal whose value is exactly a hook's variable name, plain
(escapes decoded) or raw, must sit in a statement or item that is itself, or
inside a construct that is, attributed #[cfg(debug_assertions)],
#[cfg(test)] or #[cfg(all(...))] with one of those as a conjunct. String
literals and comments are found by lexing; enclosing constructs by rustfmt
indentation. cfg(any(...)), a negation or a cfg_attr does not gate. A hook
that no longer appears where it is listed fails too: move the entry with the
code. A name assembled at run time from pieces is outside what a literal
scan can see.

Usage: check-release-source-test-hooks <commit-ish>
Exit 0 = every hook is gated, 1 = a hook reaches release builds, 2 = usage.
"""

from __future__ import annotations

import re
import subprocess
import sys

# (file, environment variable the hook reads)
HOOKS = (
    ("crates/meerkat/src/factory.rs", "RKAT_TEST_CLIENT"),
    ("crates/meerkat-auth-core/src/oauth_flow.rs", "MEERKAT_TEST_OAUTH_ENDPOINT_OVERRIDE"),
    ("crates/meerkat-auth-core/src/oauth_flow.rs", "MEERKAT_TEST_OAUTH_BASE_URL"),
)
GATE_NAMES = {"debug_assertions", "test"}
# One not(...), with at most one level of parentheses inside.
NEGATION = re.compile(r"not\((?:[^()]|\([^()]*\))*\)")
RAW_STRING_START = re.compile(r'[bc]?r(#*)"')
SIMPLE_ESCAPES = {"n": "\n", "r": "\r", "t": "\t", "0": "\0", "\\": "\\", '"': '"', "'": "'"}
# Rust's Unicode escape body: 1 to 6 hex digits, each followed by any
# number of underscores (Rust Reference, tokens).
UNICODE_ESCAPE = re.compile(r"\{((?:[0-9A-Fa-f]_*){1,6})\}")
IDENTIFIER_CHAR = re.compile(r"[A-Za-z0-9_]")


def unescape(body: str, byte_string: bool = False) -> str | None:
    """The value of an ordinary (or byte or C) string literal's body, or
    None when it holds an escape this check cannot decode: such a literal
    fails the check rather than drop out of the comparison."""
    value = []
    index = 0
    while index < len(body):
        char = body[index]
        if char != "\\":
            value.append(char)
            index += 1
            continue
        escape = body[index + 1:index + 2]
        if escape in SIMPLE_ESCAPES:
            value.append(SIMPLE_ESCAPES[escape])
            index += 2
        elif escape == "\n" or body.startswith("\r\n", index + 1):
            # A line continuation skips the newline and leading whitespace.
            index += 2
            while index < len(body) and body[index] in " \t\r\n":
                index += 1
        elif escape == "x":
            digits = body[index + 2:index + 4]
            pattern = r"[0-9A-Fa-f]{2}" if byte_string else r"[0-7][0-9A-Fa-f]"
            if not re.fullmatch(pattern, digits):
                return None
            value.append(chr(int(digits, 16)))
            index += 4
        elif escape == "u" and not byte_string:
            match = UNICODE_ESCAPE.match(body, index + 2)
            if not match:
                return None
            code = int(match.group(1).replace("_", ""), 16)
            if code > 0x10FFFF or 0xD800 <= code <= 0xDFFF:
                return None
            value.append(chr(code))
            index = match.end()
        else:
            return None
    return "".join(value)


def lex(text: str) -> tuple[list[bool], list[tuple[int, str | None]]]:
    """Which lines begin in code rather than inside a string literal or block
    comment, and the value of every string literal, plain or raw, as (line
    index, value); the value is None when an escape cannot be decoded."""
    in_code = [True]
    strings: list[tuple[int, str | None]] = []
    index, end = 0, len(text)

    def skip_to(stop: int) -> None:
        nonlocal index
        in_code.extend([False] * text.count("\n", index, stop))
        index = stop

    while index < end:
        char = text[index]
        raw = None
        if char in "bcr" and (index == 0 or not IDENTIFIER_CHAR.match(text[index - 1])):
            raw = RAW_STRING_START.match(text, index)
        if char == "\n":
            in_code.append(True)
            index += 1
        elif text.startswith("//", index):
            newline = text.find("\n", index)
            index = end if newline < 0 else newline
        elif text.startswith("/*", index):
            depth, cursor = 1, index + 2
            while cursor < end and depth:
                if text.startswith("/*", cursor):
                    depth, cursor = depth + 1, cursor + 2
                elif text.startswith("*/", cursor):
                    depth, cursor = depth - 1, cursor + 2
                else:
                    cursor += 1
            skip_to(cursor)
        elif raw:
            closing = '"' + raw.group(1)
            stop = text.find(closing, raw.end())
            stop = end if stop < 0 else stop
            strings.append((len(in_code) - 1, text[raw.end():stop]))
            skip_to(min(stop + len(closing), end))
        elif char == '"':
            cursor = index + 1
            while cursor < end and text[cursor] != '"':
                cursor += 2 if text[cursor] == "\\" else 1
            byte_string = (
                index > 0
                and text[index - 1] in "bc"
                and (index < 2 or not IDENTIFIER_CHAR.match(text[index - 2]))
            )
            strings.append((len(in_code) - 1, unescape(text[index + 1:cursor], byte_string)))
            skip_to(min(cursor + 1, end))
        elif char == "'":
            if text.startswith("\\", index + 1):
                stop = text.find("'", index + 3)
                index = end if stop < 0 else stop + 1
            elif index + 2 < end and text[index + 2] == "'":
                index += 3
            else:
                index += 1  # a lifetime or loop label
        else:
            index += 1
    return in_code, strings


def indentation(line: str) -> int:
    return len(line) - len(line.lstrip(" "))


def gates(attribute: str) -> bool:
    """Whether one attribute compiles its target only in debug or test builds."""
    text = re.sub(r"\s+", "", attribute)
    match = re.fullmatch(r"#\[cfg\((.*)\)\]", text)
    if not match:
        return False
    predicate = match.group(1)
    if predicate in GATE_NAMES:
        return True
    if not (predicate.startswith("all(") and predicate.endswith(")")) or "any(" in predicate:
        return False
    conjuncts = NEGATION.sub("", predicate[len("all("):-1])
    if "(" in conjuncts:
        return False
    return any(conjunct in GATE_NAMES for conjunct in conjuncts.split(","))


def attached_attributes(lines: list[str], in_code: list[bool], start: int) -> list[str]:
    """The attributes written directly above lines[start], each as one string."""
    indent = indentation(lines[start])
    attributes = []
    pending: list[str] = []
    index = start - 1
    while index >= 0 and in_code[index]:
        body = lines[index].strip()
        if body.startswith("#["):
            attributes.append(" ".join([body, *reversed(pending)]))
            pending = []
        elif body.startswith("//") and not pending:
            pass
        elif pending or (body.startswith((")", "]")) and body.endswith("]")):
            # Inside a multi-line attribute, read from its last line upward.
            if indentation(lines[index]) < indent or not body:
                break
            pending.append(body)
        else:
            break
        index -= 1
    return attributes


def gated(lines: list[str], in_code: list[bool], number: int) -> bool:
    """Whether the code on lines[number] compiles only in debug or test builds."""
    indent = indentation(lines[number])
    if any(gates(attribute) for attribute in attached_attributes(lines, in_code, number)):
        return True
    for index in range(number - 1, -1, -1):
        if indent == 0:
            break
        line = lines[index]
        body = line.strip()
        if not in_code[index] or not body or body.startswith(("//", "#", "}", ")", "]")) or indentation(line) >= indent:
            continue
        # The start of a construct enclosing the line.
        if any(gates(attribute) for attribute in attached_attributes(lines, in_code, index)):
            return True
        indent = indentation(line)
    return False


def git(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args], capture_output=True, encoding="utf-8", errors="replace", check=False
    )


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: check-release-source-test-hooks <commit-ish>", file=sys.stderr)
        return 2
    resolved = git("rev-parse", "--verify", "--quiet", f"{sys.argv[1]}^{{commit}}")
    if resolved.returncode != 0:
        print(f"check-release-source-test-hooks: {sys.argv[1]} does not name a commit", file=sys.stderr)
        return 2
    commit = resolved.stdout.strip()

    failed = False
    for path, name in HOOKS:
        literal = f'"{name}"'
        shown = git("show", f"{commit}:{path}")
        if shown.returncode != 0:
            print(f"error: {path} does not exist at {commit}; the {literal} hook moved, update this check", file=sys.stderr)
            failed = True
            continue
        lines = shown.stdout.split("\n")
        in_code, strings = lex(shown.stdout)
        undecodable = sorted({number for number, content in strings if content is None})
        for number in undecodable:
            print(
                f"error: {path}:{number + 1} at {commit} has a string literal whose escapes this check "
                f"cannot decode, so it cannot tell whether it reads {literal}",
                file=sys.stderr,
            )
        if undecodable:
            failed = True
        found = sorted({number for number, content in strings if content == name})
        if not found:
            print(f"error: {path} at {commit} no longer reads {literal}; the hook moved, update this check", file=sys.stderr)
            failed = True
            continue
        ungated = [number for number in found if not gated(lines, in_code, number)]
        for number in ungated:
            print(
                f"error: {path}:{number + 1} at {commit} reads {literal} in release builds: "
                "neither it nor an enclosing construct is gated on debug_assertions or test",
                file=sys.stderr,
            )
        if ungated:
            failed = True
        else:
            print(f"{path}: {literal} is compiled only for debug or test builds")
    if failed:
        print(f"Binaries built from {commit} honour a built-binary test hook; do not publish them.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
