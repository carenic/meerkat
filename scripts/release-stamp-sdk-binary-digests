#!/usr/bin/env python3
"""Pin the release's rkat-rpc digests into the Python and TypeScript SDKs.

The SDKs auto-download rkat-rpc only against sha256 digests they carry
themselves, never against a value fetched beside the binary. The release
workflow stamps those digests here, before it builds either package, from the
release's own manifest: `checksums.sha256` and `index.json`, which
publish_github_release writes once from the published archives and never
changes. The digests cannot come from the version-bump hook: the binaries are
built from the bump commit.

  stamp            Read a release directory holding `checksums.sha256`,
                   `index.json` and the five rkat-rpc archives. Refuse unless
                   the manifest is the complete one for the tag, every rkat-rpc
                   archive is within the SDKs' 256 MiB download cap, re-hashes
                   to its manifest entry, carries a build attestation from the
                   repository's release workflow run from main or the tag on a
                   GitHub-hosted runner whose subject names the exact asset
                   with the archive's sha256 (`gh attestation verify`, up to
                   three attempts) and holds exactly one rkat-rpc binary at its
                   root, and both
                   SDK packages carry the tag's version. Then rewrite both
                   pinned-digest modules (archive digest from the manifest,
                   binary digest from the binary inside the verified archive)
                   and optionally write the table as JSON for `verify`.
  verify           Check what a built package pins (JSON of its CONTRACT_VERSION
                   and pinned table, dumped from the installed package) against
                   the stamped table: refuses an unstamped, wrong-version,
                   incomplete or different table.
  check-unstamped  Check that the committed modules are the unstamped
                   rendering, so a source tree pins nothing and the renderer
                   and the committed files cannot drift apart.
  require-hosted-runner
                   Fail when MEERKAT_CI_RUNNER (the runner the BuildBuddy build
                   job attests on) names a label that is not a GitHub-hosted
                   Ubuntu label, so the release stops before any crate
                   publishes. It checks the label, not where the runner is
                   hosted: the stamp's --deny-self-hosted-runners stays the
                   enforcement.
"""

from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import time
import tomllib
import zipfile
from pathlib import Path, PurePosixPath

sys.dont_write_bytecode = True

SCRIPTS = Path(__file__).resolve().parent
_spec = importlib.util.spec_from_file_location(
    "verify_release_assets", SCRIPTS / "verify-release-assets.py"
)
assert _spec is not None and _spec.loader is not None
release_assets = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(release_assets)

BINARY = "rkat-rpc"
PYTHON_MODULE = Path("sdks/python/meerkat/_rkat_rpc_digests.py")
TYPESCRIPT_MODULE = Path("sdks/typescript/src/rkat-rpc-digests.ts")
PYPROJECT = Path("sdks/python/pyproject.toml")
PACKAGE_JSON = Path("sdks/typescript/package.json")
UNSTAMPED = {"version": "", "archives": {}}
# The SDKs refuse to download a larger archive (_RKAT_RPC_ARCHIVE_MAX_BYTES in
# the Python client, RELEASE_ARCHIVE_MAX_BYTES in the TypeScript client), so a
# release must never pin one.
ARCHIVE_MAX_BYTES = 256 * 1024 * 1024
RELEASE_WORKFLOW = ".github/workflows/release.yml"
# `gh attestation verify` runs up to this many times per archive, waiting
# RELEASE_ATTESTATION_RETRY_SECONDS (default 5) and then twice that between
# attempts: a transient API failure gets two more tries, while a missing or
# mismatched attestation fails every attempt.
ATTESTATION_ATTEMPTS = 3

PYTHON_HEADER = '''"""Release-pinned sha256 digests of the rkat-rpc archives this SDK downloads.

Generated by scripts/release-stamp-sdk-binary-digests. The release workflow
stamps this file from the release's own published checksums.sha256 before it
builds the package; do not edit it. The unstamped form pins nothing, so a
source or git install refuses to download rkat-rpc (BINARY_DIGEST_UNAVAILABLE).
Each archive entry pins the release archive and the rkat-rpc binary inside it.
"""

RKAT_RPC_DIGESTS = '''

TYPESCRIPT_HEADER = """// Release-pinned sha256 digests of the rkat-rpc archives this SDK downloads.
//
// Generated by scripts/release-stamp-sdk-binary-digests. The release workflow
// stamps this file from the release's own published checksums.sha256 before
// it builds the package; do not edit it. The unstamped form pins nothing, so
// a source or git install refuses to download rkat-rpc
// (BINARY_DIGEST_UNAVAILABLE). Each archive entry pins the release archive
// and the rkat-rpc binary inside it.

/** The pinned digests of one release archive, keyed by its target triple. */
export interface PinnedRkatRpcArchive {
  readonly asset: string;
  readonly archive_sha256: string;
  readonly binary_sha256: string;
}

/** The digests one SDK version pins; `version` is "" until stamped. */
export interface RkatRpcDigests {
  readonly version: string;
  readonly archives: Readonly<Record<string, PinnedRkatRpcArchive>>;
}

export const RKAT_RPC_DIGESTS: RkatRpcDigests = """


class StampError(RuntimeError):
    pass


def render_python(table: dict) -> str:
    return PYTHON_HEADER + json.dumps(table, indent=4, sort_keys=True) + "\n"


def render_typescript(table: dict) -> str:
    return TYPESCRIPT_HEADER + json.dumps(table, indent=2, sort_keys=True) + ";\n"


def binary_name(target: str) -> str:
    return f"{BINARY}.exe" if "windows" in target else BINARY


def release_targets() -> list[tuple[str, str]]:
    return list(release_assets.TARGET_ARCHIVES)


def asset_name(version: str, target: str, extension: str) -> str:
    return f"{BINARY}-{version}-{target}.{extension}"


def normalized(tag: str) -> tuple[str, str]:
    try:
        return release_assets.normalized_version(tag)
    except release_assets.ReleaseAssetError as error:
        raise StampError(str(error)) from error


def read_complete_manifest(release_dir: Path, tag: str, version: str) -> dict[str, str]:
    """The manifest's archive digests, refusing anything but the complete one."""
    expected_names = release_assets.expected_archive_names(version)
    index_path = release_dir / release_assets.MANIFEST_NAME
    try:
        index = json.loads(index_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise StampError(f"cannot read {release_assets.MANIFEST_NAME}: {error}") from error
    expected_index = {
        "version": version,
        "tag": tag,
        "artifacts": expected_names,
        "checksums": release_assets.CHECKSUMS_NAME,
    }
    if index != expected_index:
        raise StampError(
            f"{release_assets.MANIFEST_NAME} is not the complete {tag} manifest"
        )
    try:
        checksums = release_assets.read_checksums(
            release_dir / release_assets.CHECKSUMS_NAME
        )
    except release_assets.ReleaseAssetError as error:
        raise StampError(str(error)) from error
    if set(checksums) != set(expected_names):
        raise StampError(
            release_assets.describe_set_mismatch(
                f"{release_assets.CHECKSUMS_NAME} entries",
                set(expected_names),
                set(checksums),
            )
        )
    return checksums


def _sha256_stream(source) -> str:
    digest = hashlib.sha256()
    for chunk in iter(lambda: source.read(1 << 20), b""):
        digest.update(chunk)
    return digest.hexdigest()


def archived_binary_sha256(archive_path: Path, target: str) -> str:
    """The sha256 of the one rkat-rpc binary at the root of a verified archive."""
    name = binary_name(target)
    refusal = StampError(
        f"{archive_path.name} must hold exactly one regular file {name!r} at its root"
    )
    try:
        if archive_path.name.endswith(".tar.gz"):
            with tarfile.open(archive_path, "r:gz") as archive:
                members = [
                    member
                    for member in archive.getmembers()
                    if PurePosixPath(member.name).name == name
                ]
                if len(members) != 1 or members[0].name != name or not members[0].isfile():
                    raise refusal
                source = archive.extractfile(members[0])
                if source is None:
                    raise refusal
                with source:
                    return _sha256_stream(source)
        with zipfile.ZipFile(archive_path) as archive:
            entries = [
                entry
                for entry in archive.infolist()
                if PurePosixPath(entry.filename).name == name
            ]
            if len(entries) != 1 or entries[0].filename != name or entries[0].is_dir():
                raise refusal
            with archive.open(entries[0]) as source:
                return _sha256_stream(source)
    except (OSError, tarfile.TarError, zipfile.BadZipFile) as error:
        raise StampError(f"cannot read {archive_path.name}: {error}") from error


def release_signer_identity(repo: str, tag: str) -> str:
    """The certificate identity a release archive's attestation must carry:
    `repo`'s release workflow run from main (prebuild and asset recovery) or
    from the release tag itself (a tag run), anchored at both ends."""
    return (
        f"^https://github\\.com/{re.escape(repo)}/{re.escape(RELEASE_WORKFLOW)}"
        f"@refs/(heads/main|tags/{re.escape(tag)})$"
    )


def attestation_retry_seconds() -> float:
    raw = os.environ.get("RELEASE_ATTESTATION_RETRY_SECONDS", "5")
    try:
        seconds = float(raw)
    except ValueError:
        seconds = -1.0
    if not seconds >= 0:
        raise StampError(
            f"RELEASE_ATTESTATION_RETRY_SECONDS must be a non-negative number, not {raw!r}"
        )
    return seconds


def attested_subject_failure(stdout: str, asset: str, sha256: str) -> str | None:
    """Why `gh attestation verify --format json` output does not bind this
    archive, or None when a verified statement names `asset` (the version is
    in the name) with `sha256`. The identity alone (main) names no commit, so
    the attested subject is what binds the release version."""
    try:
        results = json.loads(stdout)
    except ValueError:
        return "gh printed no JSON verification result"
    if not isinstance(results, list):
        return "gh printed no JSON verification result"
    subjects = [
        subject
        for result in results
        if isinstance(result, dict)
        for subject in (
            ((result.get("verificationResult") or {}).get("statement") or {}).get("subject")
            or []
        )
        if isinstance(subject, dict)
    ]
    for subject in subjects:
        digest = subject.get("digest")
        if (
            subject.get("name") == asset
            and isinstance(digest, dict)
            and digest.get("sha256") == sha256
        ):
            return None
    return f"no verified attestation subject names {asset} with sha256 {sha256}"


def verify_attestation(archive_path: Path, repo: str, tag: str, sha256: str) -> None:
    """Require a build attestation from `repo`'s release workflow, run from
    main or from `tag` on a GitHub-hosted runner, whose subject names this
    exact asset with its sha256."""
    gh = shutil.which("gh")
    if gh is None:
        raise StampError("the GitHub CLI (gh) is required to verify archive attestations")
    command = [
        gh,
        "attestation",
        "verify",
        str(archive_path),
        "--repo",
        repo,
        "--cert-identity-regex",
        release_signer_identity(repo, tag),
        "--deny-self-hosted-runners",
        "--format",
        "json",
    ]
    delay = attestation_retry_seconds()
    failures = []
    for attempt in range(1, ATTESTATION_ATTEMPTS + 1):
        result = subprocess.run(command, capture_output=True, text=True, check=False)
        if result.returncode == 0:
            failure = attested_subject_failure(result.stdout, archive_path.name, sha256)
            if failure is None:
                return
        else:
            lines = (result.stderr or result.stdout).strip().splitlines()
            failure = lines[-1] if lines else f"gh exited {result.returncode}"
        failures.append(f"attempt {attempt}: {failure}")
        if attempt < ATTESTATION_ATTEMPTS:
            time.sleep(delay * 2 ** (attempt - 1))
    raise StampError(
        f"{archive_path.name} has no build attestation that passes from {repo}'s release "
        f"workflow (main or {tag}, GitHub-hosted runner, subject {archive_path.name}) "
        f"after {ATTESTATION_ATTEMPTS} attempts: {'; '.join(failures)}"
    )


# A GitHub-hosted Ubuntu runner label, the only kind the release preflight
# accepts for MEERKAT_CI_RUNNER (release.yml defaults it to "ubuntu-24.04").
GITHUB_HOSTED_UBUNTU = re.compile(r"ubuntu-(latest|[0-9]+\.[0-9]+)(-arm)?")


def require_hosted_runner(value: str) -> str:
    """The runner label `value` (MEERKAT_CI_RUNNER, JSON as release.yml's
    fromJSON reads it) names, refused unless it is a GitHub-hosted Ubuntu
    label. A label says nothing certain about where a runner is hosted; the
    attestation check (--deny-self-hosted-runners) is the enforcement."""
    if not value.strip():
        return "ubuntu-24.04"
    try:
        label = json.loads(value)
    except ValueError:
        label = None
    if not isinstance(label, str) or GITHUB_HOSTED_UBUNTU.fullmatch(label) is None:
        raise StampError(
            f"MEERKAT_CI_RUNNER {value!r} names a label that is not a GitHub-hosted Ubuntu "
            "label (\"ubuntu-latest\", \"ubuntu-<version>\" or \"ubuntu-<version>-arm\"). "
            "The BuildBuddy build job attests the release archives on it, and the SDK digest "
            "stamp refuses attestations from self-hosted runners: the release could publish "
            "the crates and then refuse both SDK packages."
        )
    return label


def digest_table(release_dir: Path, tag: str, repo: str) -> dict:
    tag, version = normalized(tag)
    checksums = read_complete_manifest(release_dir, tag, version)
    archives = {}
    for target, extension in release_targets():
        asset = asset_name(version, target, extension)
        archive_path = release_dir / asset
        if not archive_path.is_file():
            raise StampError(f"{asset} is missing from {release_dir}")
        if archive_path.stat().st_size > ARCHIVE_MAX_BYTES:
            raise StampError(
                f"{asset} is larger than {ARCHIVE_MAX_BYTES // (1024 * 1024)} MiB, "
                "which the SDKs refuse to download"
            )
        actual = release_assets.sha256(archive_path)
        if actual != checksums[asset]:
            raise StampError(
                f"{asset} does not match {release_assets.CHECKSUMS_NAME}: "
                f"expected {checksums[asset]}, got {actual}"
            )
        verify_attestation(archive_path, repo, tag, actual)
        archives[target] = {
            "asset": asset,
            "archive_sha256": actual,
            "binary_sha256": archived_binary_sha256(archive_path, target),
        }
    return {"version": version, "archives": archives}


def require_sdk_versions(repo_root: Path, version: str) -> None:
    try:
        python_version = tomllib.loads((repo_root / PYPROJECT).read_text(encoding="utf-8"))[
            "project"
        ]["version"]
        typescript_version = json.loads(
            (repo_root / PACKAGE_JSON).read_text(encoding="utf-8")
        )["version"]
    except (OSError, KeyError, ValueError) as error:
        raise StampError(f"cannot read the SDK package versions: {error}") from error
    for manifest, found in ((PYPROJECT, python_version), (PACKAGE_JSON, typescript_version)):
        if found != version:
            raise StampError(f"{manifest} is version {found!r}, not the release's {version!r}")


def stamp(
    release_dir: Path, tag: str, repo: str, repo_root: Path, table_out: Path | None
) -> dict:
    table = digest_table(release_dir, tag, repo)
    require_sdk_versions(repo_root, table["version"])
    (repo_root / PYTHON_MODULE).write_text(render_python(table), encoding="utf-8")
    (repo_root / TYPESCRIPT_MODULE).write_text(render_typescript(table), encoding="utf-8")
    if table_out is not None:
        table_out.write_text(json.dumps(table, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return table


def require_complete(table: object, version: str, label: str) -> None:
    if not isinstance(table, dict) or not isinstance(table.get("archives"), dict):
        raise StampError(f"{label} is not a pinned-digest table")
    if table.get("version") != version:
        if table.get("version") == "":
            raise StampError(f"{label} is unstamped: it pins no digest")
        raise StampError(f"{label} is stamped for {table.get('version')!r}, not {version!r}")
    expected_targets = {target for target, _extension in release_targets()}
    if set(table["archives"]) != expected_targets:
        raise StampError(
            release_assets.describe_set_mismatch(
                f"{label} targets", expected_targets, set(table["archives"])
            )
        )


def verify(tag: str, expected_path: Path, actual_path: Path) -> None:
    _tag, version = normalized(tag)
    try:
        expected = json.loads(expected_path.read_text(encoding="utf-8"))
        actual = json.loads(actual_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise StampError(f"cannot read a digest table: {error}") from error
    require_complete(expected, version, "the stamped table")
    if not isinstance(actual, dict):
        raise StampError("the package's pinned digests are not a JSON object")
    if actual.get("contract_version") != version:
        raise StampError(
            f"the package's CONTRACT_VERSION {actual.get('contract_version')!r} "
            f"is not the release's {version!r}"
        )
    pinned = actual.get("digests")
    require_complete(pinned, version, "the package's pinned table")
    if pinned != expected:
        raise StampError(
            "the package pins digests that differ from the ones stamped from the release manifest"
        )


def check_unstamped(repo_root: Path) -> None:
    for module, rendered in (
        (PYTHON_MODULE, render_python(UNSTAMPED)),
        (TYPESCRIPT_MODULE, render_typescript(UNSTAMPED)),
    ):
        try:
            committed = (repo_root / module).read_text(encoding="utf-8")
        except OSError as error:
            raise StampError(f"cannot read {module}: {error}") from error
        if committed != rendered:
            raise StampError(
                f"{module} is not the unstamped rendering of "
                "scripts/release-stamp-sdk-binary-digests"
            )


def parse_args() -> argparse.Namespace:
    # No prefix matching: --repo must never be read as --repo-root.
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0], allow_abbrev=False)
    commands = parser.add_subparsers(dest="command", required=True)

    stamp_args = commands.add_parser(
        "stamp", help="pin a release's digests into both SDKs", allow_abbrev=False
    )
    stamp_args.add_argument("--release-dir", type=Path, required=True)
    stamp_args.add_argument("--release-tag", required=True)
    stamp_args.add_argument(
        "--repo",
        required=True,
        help="OWNER/REPO whose release workflow must have attested every archive",
    )
    stamp_args.add_argument("--repo-root", type=Path, default=Path.cwd())
    stamp_args.add_argument("--table-out", type=Path)

    verify_args = commands.add_parser(
        "verify", help="check a built package's pinned digests", allow_abbrev=False
    )
    verify_args.add_argument("--release-tag", required=True)
    verify_args.add_argument("--expected", type=Path, required=True)
    verify_args.add_argument("--actual", type=Path, required=True)

    unstamped_args = commands.add_parser(
        "check-unstamped", help="check the committed modules pin nothing", allow_abbrev=False
    )
    unstamped_args.add_argument("--repo-root", type=Path, default=Path.cwd())

    commands.add_parser(
        "require-hosted-runner",
        help="fail when MEERKAT_CI_RUNNER names a label that is not a GitHub-hosted Ubuntu label",
        allow_abbrev=False,
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    try:
        if args.command == "stamp":
            table = stamp(
                args.release_dir, args.release_tag, args.repo, args.repo_root, args.table_out
            )
            print(
                f"pinned {len(table['archives'])} rkat-rpc archives of "
                f"{args.release_tag} into {PYTHON_MODULE} and {TYPESCRIPT_MODULE}"
            )
        elif args.command == "verify":
            verify(args.release_tag, args.expected, args.actual)
            print(f"the package pins the stamped {args.release_tag} rkat-rpc digests")
        elif args.command == "require-hosted-runner":
            label = require_hosted_runner(os.environ.get("MEERKAT_CI_RUNNER", ""))
            print(f"MEERKAT_CI_RUNNER names the GitHub-hosted Ubuntu label {label}")
        else:
            check_unstamped(args.repo_root)
            print("the committed SDK digest modules pin nothing")
    except StampError as error:
        print(f"release-stamp-sdk-binary-digests: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
