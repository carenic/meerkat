  "capture": {
    "composition": "rpc_gateway --persistent over a persistent_state directory with a roster of member agents; runtime.sqlite is that gateway's standalone WholeBlob SqliteRuntimeStore",
    "boots": 3,
    "clean_shutdown": true,
    "model": "loopback chat-completions model with synthetic replies; a user message can make it report an input cost above the auto-compaction threshold once, which compacts that session",
    "compaction": "the 0.9.3 defaults: history_retained_rewrites 4, min_turns_between_compactions 3",
    "re_anchored": "two sessions compacted six times each, so the gateway retired the two oldest rewrite occurrences of each; one of the two sessions was deleted under 0.9.3 and its member continued on a new session, so its runtime remains bound to nothing"
  },
